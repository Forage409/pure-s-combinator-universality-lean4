import plain_tape
import fixed_universal_endpoint

/-!
# Root-Restarted Finite Tree-Walking Controller Universality Separation Theorem over the Trivial Rule `leaf → node leaf leaf`

Machine-checked in Lean 4.33.1 with zero `sorry`, zero custom axioms, and zero `Classical.choice`
(`#print axioms` uses at most `[propext, Quot.sound]`).

## Main Result (Controller-Power Separation Theorem)
Consider the algebraically trivial binary-tree rewrite system `(BTree, LeafStep)` generated by the
single contextually closed leaf-splitting rule:
  `leaf → node leaf leaf`
which has **zero copying**, **zero arity-3 interaction**, **zero S-combinator**, and strictly adds
exactly `+1` leaf per rewrite step (`leafCount b = leafCount a + 1`).

We construct:
1. A **genuine finite-state root-restarted tree-walking controller** (`WalkerState`, `walkerDelta`)
   whose single micro-tick transition `walkerDelta program q isLeafFocus parentKind` inspects **only**
   its bounded finite control state `q : WalkerState`, the 1-bit root label `isLeafFocus : Bool` at
   the cursor, and the cursor's child-direction `parentKind : ParentKind` (`root | leftChild | rightChild`),
   and upon firing a single `leaf → node leaf leaf` split **wipes all controller state and restarts
   at the root in initial state `.init`** (`TrivialRootResetStep`);
2. A **fixed 3-state deterministic bottom-up regular tree automaton** (`evalHaltAut`, `btreeHaltAccepts`)
   with zero program parameters recognizing the halting tree language;
3. A **100% constructive (`zero Classical.choice`) Turing-universality equivalence** for any
   132-state binary Turing program `program : BinaryProgram` — and specifically the universal
   `fixedBinaryProgram` from `fixed_universal_endpoint`:
     `PlainEventuallyStops fixedBinaryProgram initial ↔`
     `∃ k reached, TrivialRootResetTrace fixedBinaryProgram k (encodeInitialBTree initial) reached ∧`
     `  btreeHaltAccepts reached = true`.

This establishes formally why coupling a rewrite system to a program-carrying root-restarted
tree-walking controller + regular halting observer does **not** witness intrinsic computational
universality of the underlying rewrite rule (cf. Kutrib & Meyer 2023).
-/

namespace FormalAlgebra.TrivialRuleSeparation

/-! ## 1. The Trivial Leaf-Splitting Rewrite System `(BTree, LeafStep)` and 3-State Halting Automaton -/

inductive BTree where
  | leaf : BTree
  | node : BTree → BTree → BTree
  deriving DecidableEq, Repr

inductive LeafStep : BTree → BTree → Prop where
  | split : LeafStep .leaf (.node .leaf .leaf)
  | left {l l' r : BTree} : LeafStep l l' → LeafStep (.node l r) (.node l' r)
  | right {l r r' : BTree} : LeafStep r r' → LeafStep (.node l r) (.node l r')

def leafCount : BTree → Nat
  | .leaf => 1
  | .node l r => leafCount l + leafCount r

/-- Every `LeafStep` increases the leaf count by strictly `+1` (no subtree duplication, no erasure). -/
theorem leafStep_adds_one_leaf {a b : BTree} (h : LeafStep a b) :
    leafCount b = leafCount a + 1 := by
  induction h with
  | split => rfl
  | @left l l' r _ ih =>
    simp only [leafCount, ih]
    rw [Nat.add_assoc, Nat.add_comm 1 (leafCount r), ← Nat.add_assoc]
  | @right l r r' _ ih =>
    simp only [leafCount, ih, Nat.add_assoc]

/-- Fixed 3-state deterministic bottom-up tree automaton recognizing halted trees `.node (.node _ _) _`. -/
inductive BTreeHaltState where
  | sLeaf : BTreeHaltState
  | sNodeNonAcc : BTreeHaltState
  | sNodeAcc : BTreeHaltState
  deriving DecidableEq, Repr

def haltAutTransition : BTreeHaltState → BTreeHaltState → BTreeHaltState
  | .sLeaf, _ => .sNodeNonAcc
  | _, _ => .sNodeAcc

def evalHaltAut : BTree → BTreeHaltState
  | .leaf => .sLeaf
  | .node l r => haltAutTransition (evalHaltAut l) (evalHaltAut r)

def btreeHaltAccepts (t : BTree) : Bool :=
  decide (evalHaltAut t = .sNodeAcc)

theorem btreeHaltAccepts_node_leaf (r : BTree) :
    btreeHaltAccepts (.node .leaf r) = false := rfl

private theorem evalHaltAut_node_node (a b r : BTree) :
    evalHaltAut (.node (.node a b) r) = .sNodeAcc := by
  simp only [evalHaltAut]
  cases evalHaltAut a <;> rfl

theorem btreeHaltAccepts_node_node (a b r : BTree) :
    btreeHaltAccepts (.node (.node a b) r) = true := by
  simp only [btreeHaltAccepts, evalHaltAut_node_node]
  rfl

/-! ## 2. Huet Zipper, Finite Cell Alphabet (`Fin 1056`), and Finite-State Root-Restarted Walker -/

inductive Crumb where
  | leftCrumb : BTree → Crumb
  | rightCrumb : BTree → Crumb
  deriving DecidableEq, Repr

inductive ParentKind where
  | root : ParentKind
  | leftChild : ParentKind
  | rightChild : ParentKind
  deriving DecidableEq, Repr

def parentKind : List Crumb → ParentKind
  | [] => .root
  | .leftCrumb _ :: _ => .leftChild
  | .rightCrumb _ :: _ => .rightChild

def isLeafFocus : BTree → Bool
  | .leaf => true
  | .node _ _ => false

def plugZipper : BTree → List Crumb → BTree
  | foc, [] => foc
  | foc, .leftCrumb r :: cs => plugZipper (.node foc r) cs
  | foc, .rightCrumb l :: cs => plugZipper (.node l foc) cs

theorem plugZipper_leafStep {a b : BTree} (h : LeafStep a b) (cs : List Crumb) :
    LeafStep (plugZipper a cs) (plugZipper b cs) := by
  induction cs generalizing a b with
  | nil => exact h
  | cons c cs ih =>
    cases c with
    | leftCrumb r => exact ih (LeafStep.left h)
    | rightCrumb l => exact ih (LeafStep.right h)

/-- Cell status values for the 2-phase atomic handshake simulating 132-state Turing tapes. -/
inductive CellVal where
  | off : Bool → CellVal
  | active : Bool → Fin 132 → CellVal
  | movingRight : Bool → Fin 132 → CellVal
  | movingLeft : Bool → Fin 132 → CellVal
  deriving DecidableEq, Repr

abbrev PayloadCode := Fin 1056

private theorem tag_add_mul8_lt (tag : Nat) (q : Fin 132) (htag : tag < 8) :
    tag + q.val * 8 < 1056 := by
  have hq : q.val ≤ 131 := Nat.le_of_lt_succ q.isLt
  have hm : q.val * 8 ≤ 131 * 8 := Nat.mul_le_mul_right 8 hq
  exact Nat.lt_of_lt_of_le (Nat.add_lt_add_right htag (q.val * 8))
    (Nat.le_trans (Nat.add_le_add_left hm 8) (by decide : 8 + 131 * 8 ≤ 1056))

def encodeCellVal : CellVal → PayloadCode
  | .off false => ⟨0, by decide⟩
  | .off true => ⟨1, by decide⟩
  | .active false q => ⟨2 + q.val * 8, tag_add_mul8_lt 2 q (by decide)⟩
  | .active true q => ⟨3 + q.val * 8, tag_add_mul8_lt 3 q (by decide)⟩
  | .movingRight false q => ⟨4 + q.val * 8, tag_add_mul8_lt 4 q (by decide)⟩
  | .movingRight true q => ⟨5 + q.val * 8, tag_add_mul8_lt 5 q (by decide)⟩
  | .movingLeft false q => ⟨6 + q.val * 8, tag_add_mul8_lt 6 q (by decide)⟩
  | .movingLeft true q => ⟨7 + q.val * 8, tag_add_mul8_lt 7 q (by decide)⟩

def decodeCellVal (c : PayloadCode) : CellVal :=
  let q : Fin 132 := ⟨(c.val / 8) % 132, Nat.mod_lt _ (by decide : 0 < 132)⟩
  match c.val % 8 with
  | 0 => .off false
  | 1 => .off true
  | 2 => .active false q
  | 3 => .active true q
  | 4 => .movingRight false q
  | 5 => .movingRight true q
  | 6 => .movingLeft false q
  | _ => .movingLeft true q

private theorem div8_mod132_eq (tag : Nat) (q : Fin 132) (htag : tag / 8 = 0) :
    (⟨((tag + q.val * 8) / 8) % 132, Nat.mod_lt _ (by decide : 0 < 132)⟩ : Fin 132) = q := by
  apply Fin.ext
  change ((tag + q.val * 8) / 8) % 132 = q.val
  rw [Nat.add_mul_div_right tag q.val (by decide : 0 < 8), htag, Nat.zero_add]
  exact Nat.mod_eq_of_lt q.isLt

theorem decode_encode_cellVal (v : CellVal) : decodeCellVal (encodeCellVal v) = v := by
  cases v with
  | off b => cases b <;> rfl
  | active b q =>
    cases b
    · simp only [encodeCellVal, decodeCellVal, Nat.add_mul_mod_self_right]
      exact congrArg (CellVal.active false) (div8_mod132_eq 2 q rfl)
    · simp only [encodeCellVal, decodeCellVal, Nat.add_mul_mod_self_right]
      exact congrArg (CellVal.active true) (div8_mod132_eq 3 q rfl)
  | movingRight b q =>
    cases b
    · simp only [encodeCellVal, decodeCellVal, Nat.add_mul_mod_self_right]
      exact congrArg (CellVal.movingRight false) (div8_mod132_eq 4 q rfl)
    · simp only [encodeCellVal, decodeCellVal, Nat.add_mul_mod_self_right]
      exact congrArg (CellVal.movingRight true) (div8_mod132_eq 5 q rfl)
  | movingLeft b q =>
    cases b
    · simp only [encodeCellVal, decodeCellVal, Nat.add_mul_mod_self_right]
      exact congrArg (CellVal.movingLeft false) (div8_mod132_eq 6 q rfl)
    · simp only [encodeCellVal, decodeCellVal, Nat.add_mul_mod_self_right]
      exact congrArg (CellVal.movingLeft true) (div8_mod132_eq 7 q rfl)

def incPayloadSat (c : PayloadCode) : PayloadCode :=
  if h : c.val + 1 < 1056 then ⟨c.val + 1, h⟩ else c

inductive ScanMode where
  | pass1 : ScanMode
  | pass2 : Bool → ScanMode
  | rDest : Bool → Fin 132 → ScanMode
  | lDest : Bool → Fin 132 → ScanMode
  deriving DecidableEq, Repr

/-- Strictly finite control state space of the Root-Restarted Tree-Walking Controller. -/
inductive WalkerState where
  | init : WalkerState
  | chkHalt : WalkerState
  | goPass1 : WalkerState
  | p1Spine : WalkerState
  | ascRootP2 : WalkerState
  | p2Spine : Bool → WalkerState
  | readCell : ScanMode → PayloadCode → WalkerState
  | chkRecBox : ScanMode → PayloadCode → WalkerState
  | chkCommitFlag : ScanMode → PayloadCode → WalkerState
  | upRecUncommitted : ScanMode → PayloadCode → WalkerState
  | ascFromUncommitted : ScanMode → PayloadCode → WalkerState
  | goPayload : ScanMode → WalkerState
  | countPayload : ScanMode → PayloadCode → WalkerState
  | ascPayload : ScanMode → PayloadCode → WalkerState
  | stepNextVer : ScanMode → PayloadCode → WalkerState
  | ascVer : ScanMode → PayloadCode → WalkerState
  | atTapeAfterRead : ScanMode → PayloadCode → WalkerState
  | rCheckDest : Bool → Fin 132 → WalkerState
  | lGoDest : Bool → Fin 132 → WalkerState
  | goWriteHere : PayloadCode → WalkerState
  | ascRootHalt : WalkerState
  | splitNow : WalkerState
  | writeCell : PayloadCode → WalkerState
  | wChkBox : PayloadCode → WalkerState
  | wChkFlag : PayloadCode → WalkerState
  | wUpCommitted : PayloadCode → WalkerState
  | wNextVer : PayloadCode → WalkerState
  | wGoPayload : PayloadCode → WalkerState
  | wWalkPayload : PayloadCode → PayloadCode → WalkerState
  | wAscToCommit : WalkerState
  deriving DecidableEq, Repr

/-- Explicit injection into a bounded `Fin` proving `WalkerState` is a strictly finite state set
    (with bounded cardinality independent of tree size, tape length, and run duration). -/
def scanModeToNat : ScanMode → Nat
  | .pass1 => 0
  | .pass2 b => 1 + (if b then 1 else 0)
  | .rDest b q => 3 + (if b then 132 else 0) + q.val
  | .lDest b q => 267 + (if b then 132 else 0) + q.val

private theorem scanModeToNat_lt (m : ScanMode) : scanModeToNat m < 531 := by
  cases m with
  | pass1 => decide
  | pass2 b => cases b <;> decide
  | rDest b q =>
    cases b
    · exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left q.isLt 3) (by decide)
    · exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left q.isLt 135) (by decide)
  | lDest b q =>
    cases b
    · exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left q.isLt 267) (by decide)
    · exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left q.isLt 399) (by decide)

inductive WalkerAction where
  | downL : WalkerState → WalkerAction
  | downR : WalkerState → WalkerAction
  | up : WalkerState → WalkerAction
  | splitAndReset : WalkerAction
  | haltNoStep : WalkerAction
  deriving DecidableEq, Repr

/-- **Purely Local Finite-State Transition Function**:
    Depends ONLY on `(q : WalkerState, isLf : Bool, pk : ParentKind)`! -/
def walkerDelta (program : BinaryProgram) (q : WalkerState) (isLf : Bool) (pk : ParentKind) : WalkerAction :=
  match q with
  | .init =>
    if isLf then .haltNoStep else .downL .chkHalt
  | .chkHalt =>
    if !isLf then .haltNoStep else .up .goPass1
  | .goPass1 =>
    .downR .p1Spine
  | .p1Spine =>
    if isLf then .up .ascRootP2 else .downL (.readCell .pass1 ⟨0, by decide⟩)
  | .ascRootP2 =>
    if pk == .root then .downR (.p2Spine true) else .up .ascRootP2
  | .p2Spine isFirst =>
    if isLf then .haltNoStep else .downL (.readCell (.pass2 isFirst) ⟨0, by decide⟩)
  | .readCell mode last =>
    if isLf then
      if pk == .leftChild then .up (.atTapeAfterRead mode last)
      else .up (.ascVer mode last)
    else .downL (.chkRecBox mode last)
  | .chkRecBox mode last =>
    if isLf then .up (.ascFromUncommitted mode last)
    else .downL (.chkCommitFlag mode last)
  | .chkCommitFlag mode last =>
    if isLf then .up (.upRecUncommitted mode last)
    else .up (.goPayload mode)
  | .upRecUncommitted mode last =>
    .up (.ascFromUncommitted mode last)
  | .ascFromUncommitted mode last =>
    if pk == .leftChild then .up (.atTapeAfterRead mode last)
    else .up (.ascVer mode last)
  | .goPayload mode =>
    .downR (.countPayload mode ⟨0, by decide⟩)
  | .countPayload mode cnt =>
    if isLf then .up (.ascPayload mode cnt)
    else .downR (.countPayload mode (incPayloadSat cnt))
  | .ascPayload mode cnt =>
    if pk == .leftChild then .up (.stepNextVer mode cnt)
    else .up (.ascPayload mode cnt)
  | .stepNextVer mode cnt =>
    .downR (.readCell mode cnt)
  | .ascVer mode last =>
    if pk == .leftChild then .up (.atTapeAfterRead mode last)
    else .up (.ascVer mode last)
  | .atTapeAfterRead mode code =>
    match mode with
    | .pass1 =>
      match decodeCellVal code with
      | .movingRight written nextQ => .downR (.rCheckDest written nextQ)
      | .movingLeft written nextQ => .up (.lGoDest written nextQ)
      | _ => .downR .p1Spine
    | .pass2 isFirst =>
      match decodeCellVal code with
      | .active bit st =>
        match program st bit with
        | none => .up .ascRootHalt
        | some inst =>
          match inst.direction with
          | .stay => .downL (.writeCell (encodeCellVal (.active inst.write inst.next)))
          | .right => .downL (.writeCell (encodeCellVal (.movingRight inst.write inst.next)))
          | .left =>
            if isFirst then .downL (.writeCell (encodeCellVal (.active inst.write inst.next)))
            else .downL (.writeCell (encodeCellVal (.movingLeft inst.write inst.next)))
      | _ => .downR (.p2Spine false)
    | .rDest written nextQ =>
      match decodeCellVal code with
      | .off destBit => .downL (.writeCell (encodeCellVal (.active destBit nextQ)))
      | _ => .up (.goWriteHere (encodeCellVal (.off written)))
    | .lDest written nextQ =>
      match decodeCellVal code with
      | .off destBit => .downL (.writeCell (encodeCellVal (.active destBit nextQ)))
      | _ => .downR (.goWriteHere (encodeCellVal (.off written)))
  | .rCheckDest written nextQ =>
    if isLf then .splitAndReset
    else .downL (.readCell (.rDest written nextQ) ⟨0, by decide⟩)
  | .lGoDest written nextQ =>
    .downL (.readCell (.lDest written nextQ) ⟨0, by decide⟩)
  | .goWriteHere target =>
    .downL (.writeCell target)
  | .ascRootHalt =>
    if pk == .root then .downL .splitNow else .up .ascRootHalt
  | .splitNow =>
    if isLf then .splitAndReset else .haltNoStep
  | .writeCell target =>
    if isLf then .splitAndReset else .downL (.wChkBox target)
  | .wChkBox target =>
    if isLf then .splitAndReset else .downL (.wChkFlag target)
  | .wChkFlag target =>
    if !isLf then .up (.wUpCommitted target) else .up (.wGoPayload target)
  | .wUpCommitted target =>
    .up (.wNextVer target)
  | .wNextVer target =>
    .downR (.writeCell target)
  | .wGoPayload target =>
    .downR (.wWalkPayload target ⟨0, by decide⟩)
  | .wWalkPayload target cnt =>
    if isLf then
      if cnt.val < target.val then .splitAndReset
      else .up .wAscToCommit
    else .downR (.wWalkPayload target (incPayloadSat cnt))
  | .wAscToCommit =>
    if pk == .leftChild then .downL .splitNow else .up .wAscToCommit

inductive WalkerOutcome where
  | splitTree : BTree → WalkerOutcome
  | halted : WalkerOutcome
  deriving DecidableEq, Repr

/-- Operational micro-tick semantics of the finite-state tree-walking controller. -/
inductive WalkerEval (program : BinaryProgram) : WalkerState → BTree → List Crumb → WalkerOutcome → Prop where
  | downL {q q' : WalkerState} {l r : BTree} {cs : List Crumb} {out : WalkerOutcome} :
      walkerDelta program q false (parentKind cs) = .downL q' →
      WalkerEval program q' l (.leftCrumb r :: cs) out →
      WalkerEval program q (.node l r) cs out
  | downR {q q' : WalkerState} {l r : BTree} {cs : List Crumb} {out : WalkerOutcome} :
      walkerDelta program q false (parentKind cs) = .downR q' →
      WalkerEval program q' r (.rightCrumb l :: cs) out →
      WalkerEval program q (.node l r) cs out
  | upLeft {q q' : WalkerState} {foc r : BTree} {cs : List Crumb} {out : WalkerOutcome} :
      walkerDelta program q (isLeafFocus foc) .leftChild = .up q' →
      WalkerEval program q' (.node foc r) cs out →
      WalkerEval program q foc (.leftCrumb r :: cs) out
  | upRight {q q' : WalkerState} {l foc : BTree} {cs : List Crumb} {out : WalkerOutcome} :
      walkerDelta program q (isLeafFocus foc) .rightChild = .up q' →
      WalkerEval program q' (.node l foc) cs out →
      WalkerEval program q foc (.rightCrumb l :: cs) out
  | split {q : WalkerState} {cs : List Crumb} :
      walkerDelta program q true (parentKind cs) = .splitAndReset →
      WalkerEval program q .leaf cs (.splitTree (plugZipper (.node .leaf .leaf) cs))
  | halt {q : WalkerState} {foc : BTree} {cs : List Crumb} :
      walkerDelta program q (isLeafFocus foc) (parentKind cs) = .haltNoStep →
      WalkerEval program q foc cs .halted

theorem walkerEval_det {program : BinaryProgram} {q : WalkerState} {foc : BTree} {cs : List Crumb}
    {out1 out2 : WalkerOutcome}
    (h1 : WalkerEval program q foc cs out1) (h2 : WalkerEval program q foc cs out2) :
    out1 = out2 := by
  induction h1 generalizing out2 with
  | downL hd1 _ ih =>
    cases h2 with
    | downL hd2 sub2 => rw [hd1] at hd2; injection hd2 with hq; subst hq; exact ih sub2
    | downR hd2 _ => cases (hd1.symm.trans hd2)
    | upLeft hd2 _ => cases (hd1.symm.trans hd2)
    | upRight hd2 _ => cases (hd1.symm.trans hd2)
    | halt hd2 => cases (hd1.symm.trans hd2)
  | downR hd1 _ ih =>
    cases h2 with
    | downL hd2 _ => cases (hd1.symm.trans hd2)
    | downR hd2 sub2 => rw [hd1] at hd2; injection hd2 with hq; subst hq; exact ih sub2
    | upLeft hd2 _ => cases (hd1.symm.trans hd2)
    | upRight hd2 _ => cases (hd1.symm.trans hd2)
    | halt hd2 => cases (hd1.symm.trans hd2)
  | upLeft hd1 _ ih =>
    cases h2 with
    | downL hd2 _ => cases (hd1.symm.trans hd2)
    | downR hd2 _ => cases (hd1.symm.trans hd2)
    | upLeft hd2 sub2 => rw [hd1] at hd2; injection hd2 with hq; subst hq; exact ih sub2
    | split hd2 => cases (hd1.symm.trans hd2)
    | halt hd2 => cases (hd1.symm.trans hd2)
  | upRight hd1 _ ih =>
    cases h2 with
    | downL hd2 _ => cases (hd1.symm.trans hd2)
    | downR hd2 _ => cases (hd1.symm.trans hd2)
    | upRight hd2 sub2 => rw [hd1] at hd2; injection hd2 with hq; subst hq; exact ih sub2
    | split hd2 => cases (hd1.symm.trans hd2)
    | halt hd2 => cases (hd1.symm.trans hd2)
  | split hd1 =>
    cases h2 with
    | upLeft hd2 _ => cases (hd1.symm.trans hd2)
    | upRight hd2 _ => cases (hd1.symm.trans hd2)
    | split _ => rfl
    | halt hd2 => cases (hd1.symm.trans hd2)
  | halt hd1 =>
    cases h2 with
    | downL hd2 _ => cases (hd1.symm.trans hd2)
    | downR hd2 _ => cases (hd1.symm.trans hd2)
    | upLeft hd2 _ => cases (hd1.symm.trans hd2)
    | upRight hd2 _ => cases (hd1.symm.trans hd2)
    | split hd2 => cases (hd1.symm.trans hd2)
    | halt _ => rfl

theorem walkerEval_split_leafStep {program : BinaryProgram} {q : WalkerState} {foc : BTree}
    {cs : List Crumb} {newRoot : BTree}
    (h : WalkerEval program q foc cs (.splitTree newRoot)) :
    LeafStep (plugZipper foc cs) newRoot := by
  generalize hout : WalkerOutcome.splitTree newRoot = out at h
  induction h with
  | downL _ _ ih => exact ih hout
  | downR _ _ ih => exact ih hout
  | upLeft _ _ ih => exact ih hout
  | upRight _ _ ih => exact ih hout
  | split _ =>
    injection hout with heq
    subst heq
    exact plugZipper_leafStep LeafStep.split _
  | halt _ => cases hout

/-- **Single Root-Restarted Leaf-Splitting Step**:
    Starting fresh at `(root, [])` in `.init`, the finite-state walker splits one leaf to produce
    `root'` and resets all controller memory. -/
def TrivialRootResetStep (program : BinaryProgram) (root root' : BTree) : Prop :=
  WalkerEval program .init root [] (.splitTree root')

theorem trivialRootResetStep_is_leafStep {program : BinaryProgram} {a b : BTree}
    (h : TrivialRootResetStep program a b) : LeafStep a b :=
  walkerEval_split_leafStep h

theorem trivialRootResetStep_det {program : BinaryProgram} {a b1 b2 : BTree}
    (h1 : TrivialRootResetStep program a b1) (h2 : TrivialRootResetStep program a b2) :
    b1 = b2 := by
  have heq := walkerEval_det h1 h2
  injection heq

inductive TrivialRootResetTrace (program : BinaryProgram) : Nat → BTree → BTree → Prop where
  | zero (t : BTree) : TrivialRootResetTrace program 0 t t
  | succ {k : Nat} {a b c : BTree} :
      TrivialRootResetStep program a b →
      TrivialRootResetTrace program k b c →
      TrivialRootResetTrace program (k + 1) a c

theorem trivialTrace_trans {program : BinaryProgram} {k1 k2 : Nat} {a b c : BTree}
    (h1 : TrivialRootResetTrace program k1 a b) (h2 : TrivialRootResetTrace program k2 b c) :
    TrivialRootResetTrace program (k1 + k2) a c := by
  induction h1 with
  | zero _ => rw [Nat.zero_add]; exact h2
  | @succ k0 _ _ _ hs _ ih =>
    rw [Nat.succ_add k0 k2]
    exact TrivialRootResetTrace.succ hs (ih h2)

/-- Trace in which every pre-step tree has not yet triggered `btreeHaltAccepts`. -/
inductive NonHaltingResetTrace (program : BinaryProgram) : Nat → BTree → BTree → Prop where
  | zero (t : BTree) : NonHaltingResetTrace program 0 t t
  | succ {k : Nat} {a b c : BTree} :
      btreeHaltAccepts a = false →
      TrivialRootResetStep program a b →
      NonHaltingResetTrace program k b c →
      NonHaltingResetTrace program (k + 1) a c

theorem nonHaltingTrace_to_trace {program : BinaryProgram} {k : Nat} {a b : BTree}
    (h : NonHaltingResetTrace program k a b) : TrivialRootResetTrace program k a b := by
  induction h with
  | zero t => exact .zero t
  | succ _ hs _ ih => exact .succ hs ih

theorem nonHaltingTrace_trans {program : BinaryProgram} {k1 k2 : Nat} {a b c : BTree}
    (h1 : NonHaltingResetTrace program k1 a b) (h2 : NonHaltingResetTrace program k2 b c) :
    NonHaltingResetTrace program (k1 + k2) a c := by
  induction h1 with
  | zero _ => rw [Nat.zero_add]; exact h2
  | @succ k0 _ _ _ hna hs _ ih =>
    rw [Nat.succ_add k0 k2]
    exact .succ hna hs (ih h2)

/-! ## 3. Versioned Cell Chains, Paired Descent-Ascent Lemmas, and Atomic Staging Commit -/

def unaryTree : Nat → BTree
  | 0 => .leaf
  | n + 1 => .node .leaf (unaryTree n)

def committedRec (code : PayloadCode) (rest : BTree) : BTree :=
  .node (.node (.node .leaf .leaf) (unaryTree code.val)) rest

def buildCellChain : List PayloadCode → BTree → BTree
  | [], tail => tail
  | c :: cs, tail => committedRec c (buildCellChain cs tail)

theorem buildCellChain_snoc (hist : List PayloadCode) (c : PayloadCode) :
    buildCellChain hist (committedRec c .leaf) = buildCellChain (hist ++ [c]) .leaf := by
  induction hist with
  | nil => rfl
  | cons x xs ih => simp only [List.cons_append, buildCellChain, ih]

def cellCode (hist : List PayloadCode) : PayloadCode :=
  hist.foldl (fun _ x => x) ⟨0, by decide⟩

theorem cellCode_snoc (hist : List PayloadCode) (c : PayloadCode) :
    cellCode (hist ++ [c]) = c := by
  simp only [cellCode, List.foldl_append, List.foldl]

inductive UncommittedTail : BTree → Prop where
  | clean : UncommittedTail .leaf
  | halfAlloc : UncommittedTail (.node .leaf .leaf)
  | staging (m : Nat) (hm : m < 1056) : UncommittedTail (.node (.node .leaf (unaryTree m)) .leaf)

private theorem eval_read_payload (program : BinaryProgram) (mode : ScanMode) :
    ∀ (rem cnt : Nat) (hbound : cnt + rem < 1056) (leftSib : BTree) (cs : List Crumb) (out : WalkerOutcome),
      WalkerEval program (.ascPayload mode ⟨cnt + rem, hbound⟩) (.node leftSib (unaryTree rem)) cs out →
      WalkerEval program (.countPayload mode ⟨cnt, Nat.lt_of_le_of_lt (Nat.le_add_right cnt rem) hbound⟩)
        (unaryTree rem) (.rightCrumb leftSib :: cs) out := by
  intro rem
  induction rem with
  | zero =>
    intro cnt hbound leftSib cs out h
    exact WalkerEval.upRight rfl h
  | succ r ih =>
    intro cnt hbound leftSib cs out h
    have hcnt : cnt < 1056 := Nat.lt_of_le_of_lt (Nat.le_add_right cnt (r + 1)) hbound
    have hcnt1 : cnt + 1 < 1056 := by
      have hle : cnt + 1 ≤ cnt + (r + 1) :=
        Nat.add_le_add_left (Nat.succ_le_succ (Nat.zero_le r)) cnt
      exact Nat.lt_of_le_of_lt hle hbound
    have hbound' : (cnt + 1) + r < 1056 := by
      rw [Nat.add_assoc cnt 1 r, Nat.add_comm 1 r]
      exact hbound
    have hfin_eq : (⟨(cnt + 1) + r, hbound'⟩ : PayloadCode) = ⟨cnt + (r + 1), hbound⟩ :=
      Fin.ext (by change (cnt + 1) + r = cnt + (r + 1); rw [Nat.add_assoc cnt 1 r, Nat.add_comm 1 r])
    have h_up : WalkerEval program (.ascPayload mode ⟨(cnt + 1) + r, hbound'⟩)
        (.node .leaf (unaryTree r)) (.rightCrumb leftSib :: cs) out := by
      rw [hfin_eq]
      exact WalkerEval.upRight rfl h
    have h_sub := ih (cnt + 1) hbound' .leaf (.rightCrumb leftSib :: cs) out h_up
    have hdelta : walkerDelta program (.countPayload mode ⟨cnt, hcnt⟩) false
        (parentKind (.rightCrumb leftSib :: cs)) = .downR (.countPayload mode ⟨cnt + 1, hcnt1⟩) := by
      simp only [walkerDelta, incPayloadSat, dif_pos hcnt1]
      rfl
    exact WalkerEval.downR hdelta h_sub

private theorem eval_read_one_committed (program : BinaryProgram) (mode : ScanMode)
    (c cur : PayloadCode) (rest : BTree) (cs_ver : List Crumb) (out : WalkerOutcome)
    (h : WalkerEval program (.readCell mode c) rest
      (.rightCrumb (.node (.node .leaf .leaf) (unaryTree c.val)) :: cs_ver) out) :
    WalkerEval program (.readCell mode cur) (committedRec c rest) cs_ver out := by
  have hbound0 : 0 + c.val < 1056 := by rw [Nat.zero_add]; exact c.isLt
  have hfin0 : (⟨0 + c.val, hbound0⟩ : PayloadCode) = c := Fin.ext (Nat.zero_add c.val)
  have h5 : WalkerEval program (.ascPayload mode ⟨0 + c.val, hbound0⟩)
      (.node (.node .leaf .leaf) (unaryTree c.val)) (.leftCrumb rest :: cs_ver) out := by
    rw [hfin0]
    exact WalkerEval.upLeft rfl (WalkerEval.downR rfl h)
  have h4 := eval_read_payload program mode c.val 0 hbound0 (.node .leaf .leaf) (.leftCrumb rest :: cs_ver) out h5
  exact WalkerEval.downL rfl (WalkerEval.downL rfl (WalkerEval.upLeft rfl (WalkerEval.downR rfl h4)))

private theorem eval_read_ver_inner (program : BinaryProgram) (mode : ScanMode) :
    ∀ (hs : List PayloadCode) {tail : BTree} (_ : UncommittedTail tail)
      (cur : PayloadCode) (prevBox : BTree) (cs_prev : List Crumb) (out : WalkerOutcome),
      WalkerEval program (.ascVer mode (hs.foldl (fun _ x => x) cur))
        (.node prevBox (buildCellChain hs tail)) cs_prev out →
      WalkerEval program (.readCell mode cur) (buildCellChain hs tail)
        (.rightCrumb prevBox :: cs_prev) out := by
  intro hs
  induction hs with
  | nil =>
    intro tail htail cur prevBox cs_prev out h
    cases htail with
    | clean => exact WalkerEval.upRight rfl h
    | halfAlloc =>
      exact WalkerEval.downL rfl (WalkerEval.upLeft rfl (WalkerEval.upRight rfl h))
    | staging m _ =>
      exact WalkerEval.downL rfl (WalkerEval.downL rfl
        (WalkerEval.upLeft rfl (WalkerEval.upLeft rfl (WalkerEval.upRight rfl h))))
  | cons c rest ih =>
    intro tail htail cur prevBox cs_prev out h
    have h_up : WalkerEval program (.ascVer mode (rest.foldl (fun _ x => x) c))
        (buildCellChain (c :: rest) tail) (.rightCrumb prevBox :: cs_prev) out :=
      WalkerEval.upRight rfl h
    have h_inner := ih htail c (.node (.node .leaf .leaf) (unaryTree c.val))
      (.rightCrumb prevBox :: cs_prev) out h_up
    exact eval_read_one_committed program mode c cur (buildCellChain rest tail)
      (.rightCrumb prevBox :: cs_prev) out h_inner

private theorem eval_read_cell (program : BinaryProgram) (mode : ScanMode)
    (hist : List PayloadCode) {tail : BTree} (htail : UncommittedTail tail)
    (cur : PayloadCode) (nextCells : BTree) (cs_tape : List Crumb) (out : WalkerOutcome)
    (h : WalkerEval program (.atTapeAfterRead mode (hist.foldl (fun _ x => x) cur))
      (.node (buildCellChain hist tail) nextCells) cs_tape out) :
    WalkerEval program (.readCell mode cur) (buildCellChain hist tail)
      (.leftCrumb nextCells :: cs_tape) out := by
  cases hist with
  | nil =>
    cases htail with
    | clean => exact WalkerEval.upLeft rfl h
    | halfAlloc =>
      exact WalkerEval.downL rfl (WalkerEval.upLeft rfl (WalkerEval.upLeft rfl h))
    | staging m _ =>
      exact WalkerEval.downL rfl (WalkerEval.downL rfl
        (WalkerEval.upLeft rfl (WalkerEval.upLeft rfl (WalkerEval.upLeft rfl h))))
  | cons c hs =>
    have h_up : WalkerEval program (.ascVer mode (hs.foldl (fun _ x => x) c))
        (buildCellChain (c :: hs) tail) (.leftCrumb nextCells :: cs_tape) out :=
      WalkerEval.upLeft rfl h
    have h_inner := eval_read_ver_inner program mode hs htail c
      (.node (.node .leaf .leaf) (unaryTree c.val)) (.leftCrumb nextCells :: cs_tape) out h_up
    exact eval_read_one_committed program mode c cur (buildCellChain hs tail)
      (.leftCrumb nextCells :: cs_tape) out h_inner

private def verCrumbs : List PayloadCode → List Crumb → List Crumb
  | [], cs => cs
  | c :: hs, cs => verCrumbs hs (.rightCrumb (.node (.node .leaf .leaf) (unaryTree c.val)) :: cs)

private theorem plugZipper_verCrumbs (hist : List PayloadCode) (foc : BTree) (cs : List Crumb) :
    plugZipper foc (verCrumbs hist cs) = plugZipper (buildCellChain hist foc) cs := by
  induction hist generalizing cs with
  | nil => rfl
  | cons c hs ih => exact ih (.rightCrumb (.node (.node .leaf .leaf) (unaryTree c.val)) :: cs)

private theorem eval_write_skip_hist (program : BinaryProgram) (target : PayloadCode) :
    ∀ (hist : List PayloadCode) (tail : BTree) (cs : List Crumb) (out : WalkerOutcome),
      WalkerEval program (.writeCell target) tail (verCrumbs hist cs) out →
      WalkerEval program (.writeCell target) (buildCellChain hist tail) cs out := by
  intro hist
  induction hist with
  | nil => intro _ _ _ h; exact h
  | cons c hs ih =>
    intro tail cs out h
    have hsub := ih tail (.rightCrumb (.node (.node .leaf .leaf) (unaryTree c.val)) :: cs) out h
    exact WalkerEval.downL rfl (WalkerEval.downL rfl
      (WalkerEval.upLeft rfl (WalkerEval.upLeft rfl (WalkerEval.downR rfl hsub))))

private theorem eval_write_walk_inc (program : BinaryProgram) (target : PayloadCode) :
    ∀ (rem cnt : Nat) (hlt : cnt + rem < target.val) (leftSib : BTree) (cs : List Crumb),
      WalkerEval program (.wWalkPayload target ⟨cnt, Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.le_add_right cnt rem) hlt) target.isLt⟩)
        (unaryTree rem) (.rightCrumb leftSib :: cs)
        (.splitTree (plugZipper (.node leftSib (unaryTree (rem + 1))) cs)) := by
  intro rem
  induction rem with
  | zero =>
    intro cnt hlt leftSib cs
    have hcnt_lt : cnt < target.val := hlt
    have hdelta : walkerDelta program
        (.wWalkPayload target ⟨cnt, Nat.lt_trans hcnt_lt target.isLt⟩) true
        (parentKind (.rightCrumb leftSib :: cs)) = .splitAndReset := by
      simp only [walkerDelta, if_pos hcnt_lt]
      rfl
    exact WalkerEval.split hdelta
  | succ r ih =>
    intro cnt hlt leftSib cs
    have hcnt : cnt < 1056 :=
      Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.le_add_right cnt (r + 1)) hlt) target.isLt
    have hlt' : (cnt + 1) + r < target.val := by
      rw [Nat.add_assoc cnt 1 r, Nat.add_comm 1 r]
      exact hlt
    have hcnt1 : cnt + 1 < 1056 :=
      Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.le_add_right (cnt + 1) r) hlt') target.isLt
    have hsub := ih (cnt + 1) hlt' .leaf (.rightCrumb leftSib :: cs)
    have hdelta : walkerDelta program (.wWalkPayload target ⟨cnt, hcnt⟩) false
        (parentKind (.rightCrumb leftSib :: cs)) = .downR (.wWalkPayload target ⟨cnt + 1, hcnt1⟩) := by
      simp only [walkerDelta, incPayloadSat, dif_pos hcnt1]
      rfl
    exact WalkerEval.downR hdelta hsub

private theorem eval_write_walk_eq (program : BinaryProgram) (target : PayloadCode) :
    ∀ (rem cnt : Nat) (heq : cnt + rem = target.val) (leftSib : BTree) (cs : List Crumb) (out : WalkerOutcome),
      WalkerEval program .wAscToCommit (.node leftSib (unaryTree rem)) cs out →
      WalkerEval program (.wWalkPayload target ⟨cnt, by
        have hle : cnt ≤ target.val := heq ▸ Nat.le_add_right cnt rem
        exact Nat.lt_of_le_of_lt hle target.isLt⟩)
        (unaryTree rem) (.rightCrumb leftSib :: cs) out := by
  intro rem
  induction rem with
  | zero =>
    intro cnt heq leftSib cs out h
    have hcnt : cnt < 1056 := by
      have hle : cnt ≤ target.val := heq ▸ Nat.le_add_right cnt 0
      exact Nat.lt_of_le_of_lt hle target.isLt
    have hnot : ¬ (cnt < target.val) := by
      rw [← heq]
      exact Nat.lt_irrefl cnt
    have hdelta : walkerDelta program (.wWalkPayload target ⟨cnt, hcnt⟩) true .rightChild = .up .wAscToCommit := by
      simp only [walkerDelta, if_neg hnot]
      rfl
    exact WalkerEval.upRight hdelta h
  | succ r ih =>
    intro cnt heq leftSib cs out h
    have hcnt : cnt < 1056 := by
      have hle : cnt ≤ target.val := heq ▸ Nat.le_add_right cnt (r + 1)
      exact Nat.lt_of_le_of_lt hle target.isLt
    have heq' : (cnt + 1) + r = target.val := by
      rw [Nat.add_assoc cnt 1 r, Nat.add_comm 1 r]
      exact heq
    have hcnt1 : cnt + 1 < 1056 := by
      have hle : cnt + 1 ≤ target.val := heq' ▸ Nat.le_add_right (cnt + 1) r
      exact Nat.lt_of_le_of_lt hle target.isLt
    have h_up : WalkerEval program .wAscToCommit (.node .leaf (unaryTree r)) (.rightCrumb leftSib :: cs) out :=
      WalkerEval.upRight rfl h
    have hsub := ih (cnt + 1) heq' .leaf (.rightCrumb leftSib :: cs) out h_up
    have hdelta : walkerDelta program (.wWalkPayload target ⟨cnt, hcnt⟩) false
        (parentKind (.rightCrumb leftSib :: cs)) = .downR (.wWalkPayload target ⟨cnt + 1, hcnt1⟩) := by
      simp only [walkerDelta, incPayloadSat, dif_pos hcnt1]
      rfl
    exact WalkerEval.downR hdelta hsub

private theorem write_staging_countdown (program : BinaryProgram)
    (hist : List PayloadCode) (target : PayloadCode) (nextCells : BTree) (cs_tape : List Crumb)
    (hnohalt : ∀ tail, UncommittedTail tail →
      btreeHaltAccepts (plugZipper (.node (buildCellChain hist tail) nextCells) cs_tape) = false)
    (hroute : ∀ tail, UncommittedTail tail → ∀ out,
      WalkerEval program (.writeCell target) (buildCellChain hist tail) (.leftCrumb nextCells :: cs_tape) out →
      WalkerEval program .init (plugZipper (.node (buildCellChain hist tail) nextCells) cs_tape) [] out) :
    ∀ (rem m : Nat), m + rem = target.val →
      NonHaltingResetTrace program (rem + 1)
        (plugZipper (.node (buildCellChain hist (.node (.node .leaf (unaryTree m)) .leaf)) nextCells) cs_tape)
        (plugZipper (.node (buildCellChain (hist ++ [target]) .leaf) nextCells) cs_tape) := by
  intro rem
  induction rem with
  | zero =>
    intro m hm
    have hm_eq : m = target.val := hm
    subst hm_eq
    have htail : UncommittedTail (.node (.node .leaf (unaryTree target.val)) .leaf) :=
      UncommittedTail.staging target.val target.isLt
    let cs_ver := verCrumbs hist (.leftCrumb nextCells :: cs_tape)
    have h_commit_end : WalkerEval program .wAscToCommit (.node .leaf (unaryTree target.val))
        (.leftCrumb .leaf :: cs_ver)
        (.splitTree (plugZipper (committedRec target .leaf) cs_ver)) :=
      WalkerEval.downL rfl (WalkerEval.split rfl)
    have heq0 : 0 + target.val = target.val := Nat.zero_add target.val
    have h_walk := eval_write_walk_eq program target target.val 0 heq0 .leaf (.leftCrumb .leaf :: cs_ver) _ h_commit_end
    have h_tail : WalkerEval program (.writeCell target) (.node (.node .leaf (unaryTree target.val)) .leaf) cs_ver
        (.splitTree (plugZipper (committedRec target .leaf) cs_ver)) :=
      WalkerEval.downL rfl (WalkerEval.downL rfl (WalkerEval.upLeft rfl (WalkerEval.downR rfl h_walk)))
    have h_cell := eval_write_skip_hist program target hist _ (.leftCrumb nextCells :: cs_tape) _ h_tail
    rw [plugZipper_verCrumbs, buildCellChain_snoc] at h_cell
    have h_step : TrivialRootResetStep program
        (plugZipper (.node (buildCellChain hist (.node (.node .leaf (unaryTree target.val)) .leaf)) nextCells) cs_tape)
        (plugZipper (.node (buildCellChain (hist ++ [target]) .leaf) nextCells) cs_tape) :=
      hroute _ htail _ h_cell
    exact .succ (hnohalt _ htail) h_step (.zero _)
  | succ r ih =>
    intro m hm
    have hm_lt_t : m < target.val := by
      rw [← hm]
      exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ r)
    have hm_lt : m < 1056 := Nat.lt_trans hm_lt_t target.isLt
    have htail : UncommittedTail (.node (.node .leaf (unaryTree m)) .leaf) :=
      UncommittedTail.staging m hm_lt
    let cs_ver := verCrumbs hist (.leftCrumb nextCells :: cs_tape)
    have hlt0 : 0 + m < target.val := by rw [Nat.zero_add]; exact hm_lt_t
    have h_walk := eval_write_walk_inc program target m 0 hlt0 .leaf (.leftCrumb .leaf :: cs_ver)
    have h_tail : WalkerEval program (.writeCell target) (.node (.node .leaf (unaryTree m)) .leaf) cs_ver
        (.splitTree (plugZipper (.node (.node .leaf (unaryTree (m + 1))) .leaf) cs_ver)) :=
      WalkerEval.downL rfl (WalkerEval.downL rfl (WalkerEval.upLeft rfl (WalkerEval.downR rfl h_walk)))
    have h_cell := eval_write_skip_hist program target hist _ (.leftCrumb nextCells :: cs_tape) _ h_tail
    rw [plugZipper_verCrumbs] at h_cell
    have h_step : TrivialRootResetStep program
        (plugZipper (.node (buildCellChain hist (.node (.node .leaf (unaryTree m)) .leaf)) nextCells) cs_tape)
        (plugZipper (.node (buildCellChain hist (.node (.node .leaf (unaryTree (m + 1))) .leaf)) nextCells) cs_tape) :=
      hroute _ htail _ h_cell
    have hm' : (m + 1) + r = target.val := by
      rw [Nat.add_assoc m 1 r, Nat.add_comm 1 r]
      exact hm
    exact .succ (hnohalt _ htail) h_step (ih (m + 1) hm')

private theorem write_cell_commits (program : BinaryProgram)
    (hist : List PayloadCode) (target : PayloadCode) (nextCells : BTree) (cs_tape : List Crumb)
    (hnohalt : ∀ tail, UncommittedTail tail →
      btreeHaltAccepts (plugZipper (.node (buildCellChain hist tail) nextCells) cs_tape) = false)
    (hroute : ∀ tail, UncommittedTail tail → ∀ out,
      WalkerEval program (.writeCell target) (buildCellChain hist tail) (.leftCrumb nextCells :: cs_tape) out →
      WalkerEval program .init (plugZipper (.node (buildCellChain hist tail) nextCells) cs_tape) [] out) :
    NonHaltingResetTrace program (target.val + 3)
      (plugZipper (.node (buildCellChain hist .leaf) nextCells) cs_tape)
      (plugZipper (.node (buildCellChain (hist ++ [target]) .leaf) nextCells) cs_tape) := by
  have hc1 : WalkerEval program (.writeCell target) (buildCellChain hist .leaf)
      (.leftCrumb nextCells :: cs_tape)
      (.splitTree (plugZipper (.node .leaf .leaf) (verCrumbs hist (.leftCrumb nextCells :: cs_tape)))) :=
    eval_write_skip_hist program target hist .leaf (.leftCrumb nextCells :: cs_tape) _
      (WalkerEval.split rfl)
  rw [plugZipper_verCrumbs] at hc1
  have hs1 : TrivialRootResetStep program
      (plugZipper (.node (buildCellChain hist .leaf) nextCells) cs_tape)
      (plugZipper (.node (buildCellChain hist (.node .leaf .leaf)) nextCells) cs_tape) :=
    hroute .leaf .clean _ hc1
  have hc2 : WalkerEval program (.writeCell target) (buildCellChain hist (.node .leaf .leaf))
      (.leftCrumb nextCells :: cs_tape)
      (.splitTree (plugZipper (.node (.node .leaf (unaryTree 0)) .leaf) (verCrumbs hist (.leftCrumb nextCells :: cs_tape)))) :=
    eval_write_skip_hist program target hist (.node .leaf .leaf) (.leftCrumb nextCells :: cs_tape) _
      (WalkerEval.downL rfl (WalkerEval.split rfl))
  rw [plugZipper_verCrumbs] at hc2
  have hs2 : TrivialRootResetStep program
      (plugZipper (.node (buildCellChain hist (.node .leaf .leaf)) nextCells) cs_tape)
      (plugZipper (.node (buildCellChain hist (.node (.node .leaf (unaryTree 0)) .leaf)) nextCells) cs_tape) :=
    hroute (.node .leaf .leaf) .halfAlloc _ hc2
  have hrest := write_staging_countdown program hist target nextCells cs_tape hnohalt hroute
    target.val 0 (Nat.zero_add target.val)
  exact .succ (hnohalt .leaf .clean) hs1 (.succ (hnohalt _ .halfAlloc) hs2 hrest)

/-! ## 4. Two-Pass Priority Tape Scan (`Pass 1` Pending, `Pass 2` Active) -/

def buildTapeWithTail : List BTree → BTree → BTree
  | [], tail => tail
  | c :: cs, tail => .node c (buildTapeWithTail cs tail)

def buildTape (cells : List BTree) : BTree :=
  buildTapeWithTail cells .leaf

theorem buildTapeWithTail_append (a b : List BTree) (tail : BTree) :
    buildTapeWithTail (a ++ b) tail = buildTapeWithTail a (buildTapeWithTail b tail) := by
  induction a with
  | nil => rfl
  | cons x xs ih => simp only [List.cons_append, buildTapeWithTail, ih]

theorem buildTape_append_cons (before : List BTree) (cell : BTree) (after : List BTree) :
    buildTape (before ++ cell :: after) = buildTapeWithTail before (.node cell (buildTape after)) := by
  unfold buildTape
  rw [buildTapeWithTail_append]
  rfl

def tapeCrumbs : List BTree → List Crumb → List Crumb
  | [], cs => cs
  | c :: rest, cs => tapeCrumbs rest (.rightCrumb c :: cs)

theorem plugZipper_tapeCrumbs (before : List BTree) (foc : BTree) (cs : List Crumb) :
    plugZipper foc (tapeCrumbs before cs) = plugZipper (buildTapeWithTail before foc) cs := by
  induction before generalizing cs with
  | nil => rfl
  | cons c rest ih => exact ih (.rightCrumb c :: cs)

theorem tapeCrumbs_append (a b : List BTree) (cs : List Crumb) :
    tapeCrumbs (a ++ b) cs = tapeCrumbs b (tapeCrumbs a cs) := by
  induction a generalizing cs with
  | nil => rfl
  | cons x xs ih => exact ih (.rightCrumb x :: cs)

def IsNonPendingVal (v : CellVal) : Prop :=
  match v with
  | .off _ => True
  | .active _ _ => True
  | _ => False

def CellHasVal (cell : BTree) (v : CellVal) : Prop :=
  ∃ hist tail, UncommittedTail tail ∧ cell = buildCellChain hist tail ∧ decodeCellVal (cellCode hist) = v

def CleanCell (cell : BTree) (v : CellVal) : Prop :=
  ∃ hist, cell = buildCellChain hist .leaf ∧ decodeCellVal (cellCode hist) = v

theorem cleanCell_hasVal {cell : BTree} {v : CellVal} (h : CleanCell cell v) : CellHasVal cell v := by
  obtain ⟨hist, h1, h2⟩ := h
  exact ⟨hist, .leaf, .clean, h1, h2⟩

def AllCellsNonPending : List BTree → Prop
  | [] => True
  | c :: cs => (∃ v, IsNonPendingVal v ∧ CellHasVal c v) ∧ AllCellsNonPending cs

def AllCellsOff : List BTree → Prop
  | [] => True
  | c :: cs => (∃ b, CellHasVal c (.off b)) ∧ AllCellsOff cs

private theorem allCellsOff_imp_nonPending {cells : List BTree} (h : AllCellsOff cells) :
    AllCellsNonPending cells := by
  induction cells with
  | nil => exact True.intro
  | cons c cs ih =>
    obtain ⟨⟨b, hb⟩, hcs⟩ := h
    exact ⟨⟨.off b, True.intro, hb⟩, ih hcs⟩

private theorem allCellsNonPending_append {a b : List BTree}
    (ha : AllCellsNonPending a) (hb : AllCellsNonPending b) :
    AllCellsNonPending (a ++ b) := by
  induction a with
  | nil => exact hb
  | cons _ _ ih => exact ⟨ha.1, ih ha.2⟩

private theorem eval_p1_skip_prefix (program : BinaryProgram) :
    ∀ (before : List BTree), AllCellsNonPending before →
      ∀ (restTape : BTree) (cs : List Crumb) (out : WalkerOutcome),
        WalkerEval program .p1Spine restTape (tapeCrumbs before cs) out →
        WalkerEval program .p1Spine (buildTapeWithTail before restTape) cs out := by
  intro before
  induction before with
  | nil => intro _ _ _ _ h; exact h
  | cons c bs ih =>
    intro ⟨⟨v, hv_np, hist, tail, htail, hc_eq, hv_dec⟩, hbs⟩ restTape cs out h
    subst hc_eq
    have hsub := ih hbs restTape (.rightCrumb (buildCellChain hist tail) :: cs) out h
    have hdelta : walkerDelta program (.atTapeAfterRead .pass1 (cellCode hist)) false
        (parentKind cs) = .downR .p1Spine := by
      simp only [walkerDelta, hv_dec]
      cases v <;> try contradiction
      all_goals rfl
    have h_after := WalkerEval.downR hdelta hsub
    have h_read := eval_read_cell program .pass1 hist htail ⟨0, by decide⟩
      (buildTapeWithTail bs restTape) cs out h_after
    exact WalkerEval.downL rfl h_read

private theorem eval_p1_all_nonpending (program : BinaryProgram) :
    ∀ (cells : List BTree), AllCellsNonPending cells →
      ∀ (prev : BTree) (cs : List Crumb) (out : WalkerOutcome),
        WalkerEval program .ascRootP2 (.node prev (buildTape cells)) cs out →
        WalkerEval program .p1Spine (buildTape cells) (.rightCrumb prev :: cs) out := by
  intro cells
  induction cells with
  | nil =>
    intro _ prev cs out h
    exact WalkerEval.upRight rfl h
  | cons c rest ih =>
    intro ⟨⟨v, hv_np, hist, tail, htail, hc_eq, hv_dec⟩, hrest⟩ prev cs out h
    subst hc_eq
    have h_up : WalkerEval program .ascRootP2
        (.node (buildCellChain hist tail) (buildTape rest)) (.rightCrumb prev :: cs) out :=
      WalkerEval.upRight rfl h
    have hsub := ih hrest (buildCellChain hist tail) (.rightCrumb prev :: cs) out h_up
    have hdelta : walkerDelta program (.atTapeAfterRead .pass1 (cellCode hist)) false .rightChild = .downR .p1Spine := by
      simp only [walkerDelta, hv_dec]
      cases v <;> try contradiction
      all_goals rfl
    have h_after := WalkerEval.downR hdelta hsub
    have h_read := eval_read_cell program .pass1 hist htail ⟨0, by decide⟩
      (buildTape rest) (.rightCrumb prev :: cs) out h_after
    exact WalkerEval.downL rfl h_read

private theorem eval_p2_skip_off (program : BinaryProgram) :
    ∀ (before : List BTree), AllCellsOff before →
      ∀ (isFirst : Bool) (restTape : BTree) (cs : List Crumb) (out : WalkerOutcome),
        WalkerEval program (.p2Spine (if before.isEmpty then isFirst else false)) restTape (tapeCrumbs before cs) out →
        WalkerEval program (.p2Spine isFirst) (buildTapeWithTail before restTape) cs out := by
  intro before
  induction before with
  | nil => intro _ _ _ _ _ h; exact h
  | cons c bs ih =>
    intro ⟨⟨b, hist, tail, htail, hc_eq, hv_dec⟩, hbs⟩ isFirst restTape cs out h
    subst hc_eq
    have h_if : (if bs.isEmpty then false else false) = false := by cases bs <;> rfl
    have h' : WalkerEval program (.p2Spine (if bs.isEmpty then false else false)) restTape
        (tapeCrumbs bs (.rightCrumb (buildCellChain hist tail) :: cs)) out := by
      rw [h_if]
      exact h
    have hsub := ih hbs false restTape (.rightCrumb (buildCellChain hist tail) :: cs) out h'
    have hdelta : walkerDelta program (.atTapeAfterRead (.pass2 isFirst) (cellCode hist)) false
        (parentKind cs) = .downR (.p2Spine false) := by
      simp only [walkerDelta, hv_dec]
    have h_after := WalkerEval.downR hdelta hsub
    have h_read := eval_read_cell program (.pass2 isFirst) hist htail ⟨0, by decide⟩
      (buildTapeWithTail bs restTape) cs out h_after
    exact WalkerEval.downL rfl h_read

private theorem eval_init_to_p1_cell (program : BinaryProgram)
    {before : List BTree} (hb : AllCellsNonPending before)
    (hist : List PayloadCode) {tail : BTree} (htail : UncommittedTail tail)
    (nextCells : BTree) (out : WalkerOutcome)
    (h : WalkerEval program (.atTapeAfterRead .pass1 (cellCode hist))
      (.node (buildCellChain hist tail) nextCells) (tapeCrumbs before [.rightCrumb .leaf]) out) :
    WalkerEval program .init (.node .leaf (buildTapeWithTail before (.node (buildCellChain hist tail) nextCells))) [] out := by
  have h_read := eval_read_cell program .pass1 hist htail ⟨0, by decide⟩
    nextCells (tapeCrumbs before [.rightCrumb .leaf]) out h
  have h_p1 := eval_p1_skip_prefix program before hb (.node (buildCellChain hist tail) nextCells)
    [.rightCrumb .leaf] out (WalkerEval.downL rfl h_read)
  exact WalkerEval.downL rfl (WalkerEval.upLeft rfl (WalkerEval.downR rfl h_p1))

private theorem eval_init_to_p2_cell (program : BinaryProgram)
    {before : List BTree} (hb_off : AllCellsOff before)
    (hist : List PayloadCode) {tail : BTree} (htail : UncommittedTail tail)
    (hv_np : IsNonPendingVal (decodeCellVal (cellCode hist)))
    {after : List BTree} (ha_np : AllCellsNonPending after)
    (out : WalkerOutcome)
    (h : WalkerEval program (.atTapeAfterRead (.pass2 before.isEmpty) (cellCode hist))
      (.node (buildCellChain hist tail) (buildTape after)) (tapeCrumbs before [.rightCrumb .leaf]) out) :
    WalkerEval program .init (.node .leaf (buildTape (before ++ buildCellChain hist tail :: after))) [] out := by
  have hall_np : AllCellsNonPending (before ++ buildCellChain hist tail :: after) :=
    allCellsNonPending_append (allCellsOff_imp_nonPending hb_off)
      ⟨⟨_, hv_np, hist, tail, htail, rfl, rfl⟩, ha_np⟩
  have h_read := eval_read_cell program (.pass2 before.isEmpty) hist htail ⟨0, by decide⟩
    (buildTape after) (tapeCrumbs before [.rightCrumb .leaf]) out h
  have h_if : (if before.isEmpty then true else false) = before.isEmpty := by cases before.isEmpty <;> rfl
  have h_p2_in : WalkerEval program (.p2Spine (if before.isEmpty then true else false))
      (.node (buildCellChain hist tail) (buildTape after)) (tapeCrumbs before [.rightCrumb .leaf]) out := by
    rw [h_if]
    exact WalkerEval.downL rfl h_read
  have h_p2 := eval_p2_skip_off program before hb_off true
    (.node (buildCellChain hist tail) (buildTape after)) [.rightCrumb .leaf] out h_p2_in
  rw [← buildTape_append_cons] at h_p2
  have h_asc : WalkerEval program .ascRootP2
      (.node .leaf (buildTape (before ++ buildCellChain hist tail :: after))) [] out :=
    WalkerEval.downR rfl h_p2
  have h_p1 := eval_p1_all_nonpending program _ hall_np .leaf [] out h_asc
  exact WalkerEval.downL rfl (WalkerEval.upLeft rfl (WalkerEval.downR rfl h_p1))

private theorem eval_ascRootHalt_tapeCrumbs (program : BinaryProgram) (before : List BTree) :
    ∀ (foc : BTree) (cs : List Crumb) (out : WalkerOutcome),
      WalkerEval program .ascRootHalt (buildTapeWithTail before foc) cs out →
      WalkerEval program .ascRootHalt foc (tapeCrumbs before cs) out := by
  induction before with
  | nil => intro _ _ _ h; exact h
  | cons c rest ih =>
    intro foc cs out h
    exact ih foc (.rightCrumb c :: cs) out (WalkerEval.upRight rfl h)

/-! ## 5. Exact Simulation of `PlainConfig` and Constructive Universality Separation Theorem -/

def OffListRepresents : List BTree → List Bool → Prop
  | [], [] => True
  | c :: cs, b :: bs => CleanCell c (.off b) ∧ OffListRepresents cs bs
  | _, _ => False

theorem offList_to_allCellsOff {cells : List BTree} {bits : List Bool}
    (h : OffListRepresents cells bits) : AllCellsOff cells := by
  induction cells generalizing bits with
  | nil => exact True.intro
  | cons c cs ih =>
    cases bits with
    | nil => cases h
    | cons b bs => exact ⟨⟨b, cleanCell_hasVal h.1⟩, ih h.2⟩

theorem offList_append {c1 c2 : List BTree} {b1 b2 : List Bool}
    (h1 : OffListRepresents c1 b1) (h2 : OffListRepresents c2 b2) :
    OffListRepresents (c1 ++ c2) (b1 ++ b2) := by
  induction c1 generalizing b1 with
  | nil =>
    cases b1 with
    | nil => exact h2
    | cons _ _ => cases h1
  | cons c cs ih =>
    cases b1 with
    | nil => cases h1
    | cons b bs => exact ⟨h1.1, ih h1.2⟩

theorem offList_isEmpty_eq {cells : List BTree} {bits : List Bool}
    (h : OffListRepresents cells bits) : cells.isEmpty = bits.isEmpty := by
  cases cells <;> cases bits <;> try cases h
  all_goals rfl

private theorem offList_snoc_inv {cells : List BTree} {bits : List Bool} {b : Bool}
    (h : OffListRepresents cells (bits ++ [b])) :
    ∃ prior destCell, cells = prior ++ [destCell] ∧
      OffListRepresents prior bits ∧ CleanCell destCell (.off b) := by
  induction bits generalizing cells with
  | nil =>
    cases cells with
    | nil => cases h
    | cons c cs =>
      cases cs with
      | nil => exact ⟨[], c, rfl, True.intro, h.1⟩
      | cons _ _ => cases h.2
  | cons b0 bs ih =>
    cases cells with
    | nil => cases h
    | cons c0 cs =>
      obtain ⟨prior, dest, hcs, hp, hd⟩ := ih h.2
      exact ⟨c0 :: prior, dest, congrArg (c0 :: ·) hcs, ⟨h.1, hp⟩, hd⟩

def RepPlainBTree (root : BTree) (c : PlainConfig) : Prop :=
  ∃ (before : List BTree) (activeCell : BTree) (after : List BTree),
    root = .node .leaf (buildTape (before ++ activeCell :: after)) ∧
    OffListRepresents before c.left ∧
    CleanCell activeCell (.active c.bit c.state) ∧
    OffListRepresents after c.right

def encodeOffCell (b : Bool) : BTree :=
  buildCellChain [encodeCellVal (.off b)] .leaf

def encodeInitialBTree (c : PlainConfig) : BTree :=
  .node .leaf (buildTape
    (c.left.map encodeOffCell ++
      buildCellChain [encodeCellVal (.active c.bit c.state)] .leaf ::
      c.right.map encodeOffCell))

private theorem map_encodeOffCell_rep (bits : List Bool) :
    OffListRepresents (bits.map encodeOffCell) bits := by
  induction bits with
  | nil => exact True.intro
  | cons b bs ih =>
    refine ⟨⟨[encodeCellVal (.off b)], rfl, decode_encode_cellVal (.off b)⟩, ih⟩

theorem encodeInitialBTree_represents (c : PlainConfig) :
    RepPlainBTree (encodeInitialBTree c) c := by
  refine ⟨c.left.map encodeOffCell,
    buildCellChain [encodeCellVal (.active c.bit c.state)] .leaf,
    c.right.map encodeOffCell,
    rfl, map_encodeOffCell_rep c.left,
    ⟨[encodeCellVal (.active c.bit c.state)], rfl, decode_encode_cellVal _⟩,
    map_encodeOffCell_rep c.right⟩

private theorem eval_ascRootHalt_from_cell (program : BinaryProgram)
    (q : WalkerState) (foc : BTree)
    (hdelta : walkerDelta program q false .rightChild = .up .ascRootHalt) :
    ∀ (before : List BTree) (l0 : BTree) (cs0 : List Crumb) (out : WalkerOutcome),
      WalkerEval program .ascRootHalt (.node l0 (buildTapeWithTail before foc)) cs0 out →
      match foc with
      | .leaf => True
      | .node _ _ => WalkerEval program q foc (tapeCrumbs before (.rightCrumb l0 :: cs0)) out := by
  intro before
  induction before with
  | nil =>
    intro l0 cs0 out h
    cases foc with
    | leaf => exact True.intro
    | node _ _ => exact WalkerEval.upRight hdelta h
  | cons c rest ih =>
    intro l0 cs0 out h
    have h_up : WalkerEval program .ascRootHalt (.node c (buildTapeWithTail rest foc))
        (.rightCrumb l0 :: cs0) out :=
      WalkerEval.upRight rfl h
    exact ih c (.rightCrumb l0 :: cs0) out h_up

/-- Halting simulation: when `plainNext program c = none`, 1 root-restarted split sets `haltFlag`! -/
theorem plainStop_simulated (program : BinaryProgram) {root : BTree} {c : PlainConfig}
    (hrep : RepPlainBTree root c) (hstop : plainNext program c = none) :
    ∃ reached, btreeHaltAccepts root = false ∧
      TrivialRootResetStep program root reached ∧
      btreeHaltAccepts reached = true := by
  have hrule : program c.state c.bit = none := (plain_next_none_iff_rule_none program c).mp hstop
  obtain ⟨before, actCell, after, hroot, hb, ⟨hist, hact_eq, hact_dec⟩, ha⟩ := hrep
  subst hroot
  subst hact_eq
  let tape := buildTape (before ++ buildCellChain hist .leaf :: after)
  refine ⟨.node (.node .leaf .leaf) tape, rfl, ?_, btreeHaltAccepts_node_node .leaf .leaf tape⟩
  have heq_t : buildTapeWithTail before (.node (buildCellChain hist .leaf) (buildTape after)) = tape :=
    (buildTape_append_cons before _ after).symm
  have h_root : WalkerEval program .ascRootHalt
      (.node .leaf (buildTapeWithTail before (.node (buildCellChain hist .leaf) (buildTape after)))) []
      (.splitTree (.node (.node .leaf .leaf) tape)) := by
    rw [heq_t]
    exact WalkerEval.downL rfl (WalkerEval.split rfl)
  have hdelta : walkerDelta program (.atTapeAfterRead (.pass2 before.isEmpty) (cellCode hist)) false
      .rightChild = .up .ascRootHalt := by
    simp only [walkerDelta, hact_dec, hrule]
  have h_asc := eval_ascRootHalt_from_cell program
    (.atTapeAfterRead (.pass2 before.isEmpty) (cellCode hist))
    (.node (buildCellChain hist .leaf) (buildTape after))
    hdelta before .leaf [] _ h_root
  dsimp only at h_asc
  exact eval_init_to_p2_cell program (offList_to_allCellsOff hb) hist .clean
    (by rw [hact_dec]; exact True.intro)
    (allCellsOff_imp_nonPending (offList_to_allCellsOff ha)) _ h_asc

private theorem p2_active_writes_target (program : BinaryProgram)
    {before : List BTree} (hb : AllCellsOff before)
    (hist : List PayloadCode) {bit : Bool} {q : Fin 132}
    (hact : decodeCellVal (cellCode hist) = .active bit q)
    {after : List BTree} (ha : AllCellsNonPending after)
    (target : PayloadCode)
    (hact_delta : ∀ pk, walkerDelta program (.atTapeAfterRead (.pass2 before.isEmpty) (cellCode hist)) false pk =
      .downL (.writeCell target)) :
    NonHaltingResetTrace program (target.val + 3)
      (.node .leaf (buildTape (before ++ buildCellChain hist .leaf :: after)))
      (.node .leaf (buildTape (before ++ buildCellChain (hist ++ [target]) .leaf :: after))) := by
  have hplug : ∀ cell, plugZipper (.node cell (buildTape after)) (tapeCrumbs before [.rightCrumb .leaf]) =
      .node .leaf (buildTape (before ++ cell :: after)) := by
    intro cell
    rw [plugZipper_tapeCrumbs, ← buildTape_append_cons]
    rfl
  have htr := write_cell_commits program hist target (buildTape after) (tapeCrumbs before [.rightCrumb .leaf])
    (fun tail _ => by rw [hplug]; rfl)
    (fun tail htail out hw => by
      rw [hplug]
      exact eval_init_to_p2_cell program hb hist htail (by rw [hact]; exact True.intro) ha out
        (WalkerEval.downL (hact_delta _) hw))
  rw [hplug, hplug] at htr
  exact htr

private theorem movingRight_completes (program : BinaryProgram)
    {before : List BTree} (hb_np : AllCellsNonPending before)
    (srcHist : List PayloadCode) {written : Bool} {nextQ : Fin 132}
    (hsrc : decodeCellVal (cellCode srcHist) = .movingRight written nextQ)
    (destHist : List PayloadCode) {destBit : Bool}
    (hdest : decodeCellVal (cellCode destHist) = .off destBit)
    (rest : List BTree) :
    let tAct := encodeCellVal (.active destBit nextQ)
    let tOff := encodeCellVal (.off written)
    NonHaltingResetTrace program ((tAct.val + 3) + (tOff.val + 3))
      (.node .leaf (buildTape (before ++ buildCellChain srcHist .leaf :: buildCellChain destHist .leaf :: rest)))
      (.node .leaf (buildTape (before ++ buildCellChain (srcHist ++ [tOff]) .leaf :: buildCellChain (destHist ++ [tAct]) .leaf :: rest))) := by
  intro tAct tOff
  let srcClean := buildCellChain srcHist .leaf
  -- Phase 3b: destCell commits `tAct`
  have hplug_dest : ∀ dcell, plugZipper (.node dcell (buildTape rest))
      (tapeCrumbs (before ++ [srcClean]) [.rightCrumb .leaf]) =
      .node .leaf (buildTape (before ++ srcClean :: dcell :: rest)) := by
    intro dcell
    rw [plugZipper_tapeCrumbs, buildTapeWithTail_append]
    unfold buildTape
    rw [buildTapeWithTail_append]
    rfl
  have h_dest_commits := write_cell_commits program destHist tAct (buildTape rest)
    (tapeCrumbs (before ++ [srcClean]) [.rightCrumb .leaf])
    (fun tail _ => by rw [hplug_dest]; rfl)
    (fun tail htail out hw => by
      rw [hplug_dest]
      have hd_dest : walkerDelta program (.atTapeAfterRead (.rDest written nextQ) (cellCode destHist)) false
          (parentKind (tapeCrumbs (before ++ [srcClean]) [.rightCrumb .leaf])) = .downL (.writeCell tAct) := by
        simp only [walkerDelta, hdest]; rfl
      have h_rd_dest := eval_read_cell program (.rDest written nextQ) destHist htail ⟨0, by decide⟩
        (buildTape rest) (tapeCrumbs (before ++ [srcClean]) [.rightCrumb .leaf]) out
        (WalkerEval.downL hd_dest hw)
      have hc_eq : tapeCrumbs (before ++ [srcClean]) [.rightCrumb .leaf] =
          .rightCrumb srcClean :: tapeCrumbs before [.rightCrumb .leaf] := by
        rw [tapeCrumbs_append]
        rfl
      rw [hc_eq] at h_rd_dest
      have hd_src : walkerDelta program (.atTapeAfterRead .pass1 (cellCode srcHist)) false
          (parentKind (tapeCrumbs before [.rightCrumb .leaf])) = .downR (.rCheckDest written nextQ) := by
        simp only [walkerDelta, hsrc]
      have h_at_src := WalkerEval.downR hd_src (WalkerEval.downL rfl h_rd_dest)
      have h_init := eval_init_to_p1_cell program hb_np srcHist .clean
        (.node (buildCellChain destHist tail) (buildTape rest)) out h_at_src
      unfold buildTape
      rw [buildTapeWithTail_append]
      exact h_init)
  rw [hplug_dest, hplug_dest] at h_dest_commits
  -- Phase 3c: srcCell commits `tOff`
  let newDest := buildCellChain (destHist ++ [tAct]) .leaf
  have hnewDest_dec : decodeCellVal (cellCode (destHist ++ [tAct])) = .active destBit nextQ := by
    rw [cellCode_snoc]
    exact decode_encode_cellVal _
  have hplug_src : ∀ scell, plugZipper (.node scell (buildTape (newDest :: rest)))
      (tapeCrumbs before [.rightCrumb .leaf]) =
      .node .leaf (buildTape (before ++ scell :: newDest :: rest)) := by
    intro scell
    rw [plugZipper_tapeCrumbs, ← buildTape_append_cons]
    rfl
  have h_src_commits := write_cell_commits program srcHist tOff (buildTape (newDest :: rest))
    (tapeCrumbs before [.rightCrumb .leaf])
    (fun tail _ => by rw [hplug_src]; rfl)
    (fun tail htail out hw => by
      rw [hplug_src]
      have h_back : WalkerEval program (.goWriteHere tOff)
          (.node (buildCellChain srcHist tail) (.node newDest (buildTape rest)))
          (tapeCrumbs before [.rightCrumb .leaf]) out :=
        WalkerEval.downL rfl hw
      have hd_dest2 : walkerDelta program (.atTapeAfterRead (.rDest written nextQ) (cellCode (destHist ++ [tAct])))
          false .rightChild = .up (.goWriteHere tOff) := by
        simp only [walkerDelta, hnewDest_dec]; rfl
      have h_rd_dest2 := eval_read_cell program (.rDest written nextQ) (destHist ++ [tAct]) .clean ⟨0, by decide⟩
        (buildTape rest) (.rightCrumb (buildCellChain srcHist tail) :: tapeCrumbs before [.rightCrumb .leaf]) out
        (WalkerEval.upRight hd_dest2 h_back)
      have hd_src2 : walkerDelta program (.atTapeAfterRead .pass1 (cellCode srcHist)) false
          (parentKind (tapeCrumbs before [.rightCrumb .leaf])) = .downR (.rCheckDest written nextQ) := by
        simp only [walkerDelta, hsrc]
      have h_init2 := eval_init_to_p1_cell program hb_np srcHist htail
        (.node newDest (buildTape rest)) out (WalkerEval.downR hd_src2 (WalkerEval.downL rfl h_rd_dest2))
      have ht2 : buildTapeWithTail before (.node (buildCellChain srcHist tail) (.node newDest (buildTape rest))) =
          buildTape (before ++ buildCellChain srcHist tail :: newDest :: rest) :=
        (buildTape_append_cons before (buildCellChain srcHist tail) (newDest :: rest)).symm
      rw [ht2] at h_init2
      exact h_init2)
  rw [hplug_src, hplug_src] at h_src_commits
  exact nonHaltingTrace_trans h_dest_commits h_src_commits

private theorem movingLeft_completes (program : BinaryProgram)
    {prior : List BTree} (hp_np : AllCellsNonPending prior)
    (destHist : List PayloadCode) {destBit : Bool}
    (hdest : decodeCellVal (cellCode destHist) = .off destBit)
    (srcHist : List PayloadCode) {written : Bool} {nextQ : Fin 132}
    (hsrc : decodeCellVal (cellCode srcHist) = .movingLeft written nextQ)
    (after : List BTree) :
    let tAct := encodeCellVal (.active destBit nextQ)
    let tOff := encodeCellVal (.off written)
    NonHaltingResetTrace program ((tAct.val + 3) + (tOff.val + 3))
      (.node .leaf (buildTape (prior ++ buildCellChain destHist .leaf :: buildCellChain srcHist .leaf :: after)))
      (.node .leaf (buildTape (prior ++ buildCellChain (destHist ++ [tAct]) .leaf :: buildCellChain (srcHist ++ [tOff]) .leaf :: after))) := by
  intro tAct tOff
  let srcClean := buildCellChain srcHist .leaf
  -- Phase 4b: destCell commits `tAct`
  have hplug_dest : ∀ dcell, plugZipper (.node dcell (buildTape (srcClean :: after)))
      (tapeCrumbs prior [.rightCrumb .leaf]) =
      .node .leaf (buildTape (prior ++ dcell :: srcClean :: after)) := by
    intro dcell
    rw [plugZipper_tapeCrumbs, ← buildTape_append_cons]
    rfl
  have h_dest_commits := write_cell_commits program destHist tAct (buildTape (srcClean :: after))
    (tapeCrumbs prior [.rightCrumb .leaf])
    (fun tail _ => by rw [hplug_dest]; rfl)
    (fun tail htail out hw => by
      rw [hplug_dest]
      let dcell := buildCellChain destHist tail
      have hd_dest : walkerDelta program (.atTapeAfterRead (.lDest written nextQ) (cellCode destHist)) false
          (parentKind (tapeCrumbs prior [.rightCrumb .leaf])) = .downL (.writeCell tAct) := by
        simp only [walkerDelta, hdest]; rfl
      have h_rd_dest := eval_read_cell program (.lDest written nextQ) destHist htail ⟨0, by decide⟩
        (.node srcClean (buildTape after)) (tapeCrumbs prior [.rightCrumb .leaf]) out
        (WalkerEval.downL hd_dest hw)
      have hd_src : walkerDelta program (.atTapeAfterRead .pass1 (cellCode srcHist)) false
          .rightChild = .up (.lGoDest written nextQ) := by
        simp only [walkerDelta, hsrc]
      have h_up := WalkerEval.upRight hd_src (WalkerEval.downL rfl h_rd_dest)
      have hc_eq : tapeCrumbs (prior ++ [dcell]) [.rightCrumb .leaf] =
          .rightCrumb dcell :: tapeCrumbs prior [.rightCrumb .leaf] := by
        rw [tapeCrumbs_append]
        rfl
      rw [← hc_eq] at h_up
      have hp_d_np : AllCellsNonPending (prior ++ [dcell]) :=
        allCellsNonPending_append hp_np ⟨⟨.off destBit, True.intro, destHist, tail, htail, rfl, hdest⟩, True.intro⟩
      have h_init := eval_init_to_p1_cell program hp_d_np srcHist .clean (buildTape after) out h_up
      have h_t_eq : buildTapeWithTail (prior ++ [dcell]) (.node srcClean (buildTape after)) =
          buildTape (prior ++ dcell :: srcClean :: after) := by
        rw [← buildTape_append_cons, List.append_assoc]
        rfl
      rw [h_t_eq] at h_init
      exact h_init)
  rw [hplug_dest, hplug_dest] at h_dest_commits
  -- Phase 4c: srcCell commits `tOff`
  let newDest := buildCellChain (destHist ++ [tAct]) .leaf
  have hnewDest_dec : decodeCellVal (cellCode (destHist ++ [tAct])) = .active destBit nextQ := by
    rw [cellCode_snoc]
    exact decode_encode_cellVal _
  have hplug_src : ∀ scell, plugZipper (.node scell (buildTape after))
      (tapeCrumbs (prior ++ [newDest]) [.rightCrumb .leaf]) =
      .node .leaf (buildTape (prior ++ newDest :: scell :: after)) := by
    intro scell
    rw [plugZipper_tapeCrumbs, ← buildTape_append_cons, List.append_assoc]
    rfl
  have h_src_commits := write_cell_commits program srcHist tOff (buildTape after)
    (tapeCrumbs (prior ++ [newDest]) [.rightCrumb .leaf])
    (fun tail _ => by rw [hplug_src]; rfl)
    (fun tail htail out hw => by
      rw [hplug_src]
      let scell := buildCellChain srcHist tail
      have hc_eq : tapeCrumbs (prior ++ [newDest]) [.rightCrumb .leaf] =
          .rightCrumb newDest :: tapeCrumbs prior [.rightCrumb .leaf] := by
        rw [tapeCrumbs_append]
        rfl
      have h_go : WalkerEval program (.goWriteHere tOff) (.node scell (buildTape after))
          (.rightCrumb newDest :: tapeCrumbs prior [.rightCrumb .leaf]) out := by
        rw [← hc_eq]
        exact WalkerEval.downL rfl hw
      have hd_dest2 : walkerDelta program (.atTapeAfterRead (.lDest written nextQ) (cellCode (destHist ++ [tAct])))
          false (parentKind (tapeCrumbs prior [.rightCrumb .leaf])) = .downR (.goWriteHere tOff) := by
        simp only [walkerDelta, hnewDest_dec]; rfl
      have h_rd_dest2 := eval_read_cell program (.lDest written nextQ) (destHist ++ [tAct]) .clean ⟨0, by decide⟩
        (.node scell (buildTape after)) (tapeCrumbs prior [.rightCrumb .leaf]) out
        (WalkerEval.downR hd_dest2 h_go)
      have hd_src2 : walkerDelta program (.atTapeAfterRead .pass1 (cellCode srcHist)) false
          .rightChild = .up (.lGoDest written nextQ) := by
        simp only [walkerDelta, hsrc]
      have h_up2 := WalkerEval.upRight hd_src2 (WalkerEval.downL rfl h_rd_dest2)
      rw [← hc_eq] at h_up2
      have hp_nd_np : AllCellsNonPending (prior ++ [newDest]) :=
        allCellsNonPending_append hp_np
          ⟨⟨.active destBit nextQ, True.intro, destHist ++ [tAct], .leaf, .clean, rfl, hnewDest_dec⟩, True.intro⟩
      have h_init2 := eval_init_to_p1_cell program hp_nd_np srcHist htail (buildTape after) out h_up2
      have h_t_eq : buildTapeWithTail (prior ++ [newDest]) (.node scell (buildTape after)) =
          buildTape (prior ++ newDest :: scell :: after) := by
        rw [← buildTape_append_cons, List.append_assoc]
        rfl
      rw [h_t_eq] at h_init2
      exact h_init2)
  rw [hplug_src, hplug_src] at h_src_commits
  exact nonHaltingTrace_trans h_dest_commits h_src_commits

/-- **One-Step Turing Simulation Lemma**: Every `plainNext program c = some c'` is simulated
    by `j ≥ 1` non-halting root-restarted leaf-split steps preserving `RepPlainBTree`. -/
theorem plainStep_simulated (program : BinaryProgram) {root : BTree} {c c' : PlainConfig}
    (hrep : RepPlainBTree root c) (hstep : plainNext program c = some c') :
    ∃ j root', 1 ≤ j ∧ NonHaltingResetTrace program j root root' ∧ RepPlainBTree root' c' := by
  cases c with
  | mk leftBits bit rightBits q =>
    obtain ⟨before, actCell, after, hroot, hb, ⟨hist, hact_eq, hact_dec⟩, ha⟩ := hrep
    subst hroot
    subst hact_eq
    have hb_off := offList_to_allCellsOff hb
    have ha_np := allCellsOff_imp_nonPending (offList_to_allCellsOff ha)
    cases hrule : program q bit with
    | none => simp [plainNext, hrule] at hstep
    | some inst =>
      cases inst with
      | mk written nextQ dir =>
        cases dir with
        | stay =>
          simp only [plainNext, hrule] at hstep
          injection hstep with hc'
          subst hc'
          let tAct := encodeCellVal (.active written nextQ)
          have htr := p2_active_writes_target program hb_off hist hact_dec ha_np tAct
            (fun pk => by simp only [walkerDelta, hact_dec, hrule]; rfl)
          refine ⟨tAct.val + 3, _, Nat.le_add_left 1 (tAct.val + 2), htr, ?_⟩
          refine ⟨before, buildCellChain (hist ++ [tAct]) .leaf, after, rfl, hb, ?_, ha⟩
          exact ⟨hist ++ [tAct], rfl, by rw [cellCode_snoc]; exact decode_encode_cellVal _⟩
        | right =>
          let tMR := encodeCellVal (.movingRight written nextQ)
          have h3a := p2_active_writes_target program hb_off hist hact_dec ha_np tMR
            (fun pk => by simp only [walkerDelta, hact_dec, hrule]; rfl)
          have hmr_dec : decodeCellVal (cellCode (hist ++ [tMR])) = .movingRight written nextQ := by
            rw [cellCode_snoc]; exact decode_encode_cellVal _
          cases rightBits with
          | nil =>
            cases after with
            | cons _ _ => cases ha
            | nil =>
              simp only [plainNext, hrule] at hstep
              injection hstep with hc'
              subst hc'
              -- 1-step right-end cell allocation `.leaf -> .node .leaf .leaf`!
              let mrCell := buildCellChain (hist ++ [tMR]) .leaf
              have hd_alloc : walkerDelta program (.atTapeAfterRead .pass1 (cellCode (hist ++ [tMR]))) false
                  (parentKind (tapeCrumbs before [.rightCrumb .leaf])) = .downR (.rCheckDest written nextQ) := by
                simp only [walkerDelta, hmr_dec]
              have h_alloc_eval := eval_init_to_p1_cell program (allCellsOff_imp_nonPending hb_off)
                (hist ++ [tMR]) .clean .leaf _
                (WalkerEval.downR hd_alloc (WalkerEval.split rfl))
              have hplug_alloc : plugZipper (.node .leaf .leaf)
                  (.rightCrumb mrCell :: tapeCrumbs before [.rightCrumb .leaf]) =
                  .node .leaf (buildTape (before ++ mrCell :: [buildCellChain [] .leaf])) := by
                change plugZipper (.node mrCell (buildTape [buildCellChain [] .leaf])) (tapeCrumbs before [.rightCrumb .leaf]) = _
                rw [plugZipper_tapeCrumbs, ← buildTape_append_cons]
                rfl
              have ht0 : buildTapeWithTail before (.node mrCell .leaf) = buildTape (before ++ mrCell :: []) :=
                (buildTape_append_cons before mrCell []).symm
              rw [hplug_alloc, ht0] at h_alloc_eval
              have h3b_alloc : NonHaltingResetTrace program 1
                  (.node .leaf (buildTape (before ++ mrCell :: [])))
                  (.node .leaf (buildTape (before ++ mrCell :: [buildCellChain [] .leaf]))) :=
                .succ rfl h_alloc_eval (.zero _)
              have h3bc := movingRight_completes program (allCellsOff_imp_nonPending hb_off)
                (hist ++ [tMR]) hmr_dec [] rfl []
              have htot := nonHaltingTrace_trans (nonHaltingTrace_trans h3a h3b_alloc) h3bc
              let tAct := encodeCellVal (.active false nextQ)
              let tOff := encodeCellVal (.off written)
              refine ⟨_, _, ?_, htot, ?_⟩
              · rw [Nat.add_assoc]
                exact Nat.le_trans (Nat.le_add_left 1 (tMR.val + 2)) (Nat.le_add_right _ _)
              · refine ⟨before ++ [buildCellChain ((hist ++ [tMR]) ++ [tOff]) .leaf],
                  buildCellChain ([] ++ [tAct]) .leaf, [], ?_, ?_, ?_, True.intro⟩
                · simp only [List.append_assoc, List.singleton_append]; rfl
                · exact offList_append hb ⟨⟨(hist ++ [tMR]) ++ [tOff], rfl,
                    by rw [cellCode_snoc]; exact decode_encode_cellVal _⟩, True.intro⟩
                · exact ⟨[tAct], rfl, decode_encode_cellVal (.active false nextQ)⟩
          | cons destBit restBits =>
            cases after with
            | nil => cases ha
            | cons destCell restCells =>
              simp only [plainNext, hrule] at hstep
              injection hstep with hc'
              subst hc'
              obtain ⟨⟨destHist, hdest_eq, hdest_dec⟩, hrest_off⟩ := ha
              subst hdest_eq
              have h3bc := movingRight_completes program (allCellsOff_imp_nonPending hb_off)
                (hist ++ [tMR]) hmr_dec destHist hdest_dec restCells
              have htot := nonHaltingTrace_trans h3a h3bc
              let tAct := encodeCellVal (.active destBit nextQ)
              let tOff := encodeCellVal (.off written)
              refine ⟨_, _, ?_, htot, ?_⟩
              · exact Nat.le_trans (Nat.le_add_left 1 (tMR.val + 2)) (Nat.le_add_right _ _)
              · refine ⟨before ++ [buildCellChain ((hist ++ [tMR]) ++ [tOff]) .leaf],
                  buildCellChain (destHist ++ [tAct]) .leaf, restCells, ?_, ?_, ?_, hrest_off⟩
                · simp only [List.append_assoc, List.singleton_append]; rfl
                · exact offList_append hb ⟨⟨(hist ++ [tMR]) ++ [tOff], rfl,
                    by rw [cellCode_snoc]; exact decode_encode_cellVal _⟩, True.intro⟩
                · exact ⟨destHist ++ [tAct], rfl, by rw [cellCode_snoc]; exact decode_encode_cellVal _⟩
        | left =>
          cases hrev : leftBits.reverse with
          | nil =>
            have hleft_nil : leftBits = [] := by
              have := congrArg List.reverse hrev
              simpa using this
            subst hleft_nil
            cases before with
            | cons _ _ => cases hb
            | nil =>
              simp only [plainNext, hrule, List.reverse_nil] at hstep
              injection hstep with hc'
              subst hc'
              let tAct := encodeCellVal (.active written nextQ)
              have htr := p2_active_writes_target program hb_off hist hact_dec ha_np tAct
                (fun pk => by simp only [walkerDelta, hact_dec, hrule, List.isEmpty_nil, ite_true]; rfl)
              refine ⟨tAct.val + 3, _, Nat.le_add_left 1 (tAct.val + 2), htr, ?_⟩
              refine ⟨[], buildCellChain (hist ++ [tAct]) .leaf, after, rfl, True.intro, ?_, ha⟩
              exact ⟨hist ++ [tAct], rfl, by rw [cellCode_snoc]; exact decode_encode_cellVal _⟩
          | cons destBit restRev =>
            have hleft_eq : leftBits = restRev.reverse ++ [destBit] := by
              have := congrArg List.reverse hrev
              simpa using this
            simp only [plainNext, hrule, hrev] at hstep
            injection hstep with hc'
            subst hc'
            obtain ⟨prior, destCell, hbef_eq, hprior_off, ⟨destHist, hdest_eq, hdest_dec⟩⟩ :=
              offList_snoc_inv (hleft_eq ▸ hb)
            subst hbef_eq
            subst hdest_eq
            have hbef_ne : (prior ++ [buildCellChain destHist .leaf]).isEmpty = false := by
              cases prior <;> rfl
            let tML := encodeCellVal (.movingLeft written nextQ)
            have h4a := p2_active_writes_target program hb_off hist hact_dec ha_np tML
              (fun pk => by simp only [walkerDelta, hact_dec, hrule, hbef_ne]; rfl)
            have hml_dec : decodeCellVal (cellCode (hist ++ [tML])) = .movingLeft written nextQ := by
              rw [cellCode_snoc]; exact decode_encode_cellVal _
            have h4bc := movingLeft_completes program
              (allCellsOff_imp_nonPending (offList_to_allCellsOff hprior_off))
              destHist hdest_dec (hist ++ [tML]) hml_dec after
            have h_assoc : prior ++ [buildCellChain destHist .leaf] ++
                buildCellChain (hist ++ [tML]) .leaf :: after =
                prior ++ buildCellChain destHist .leaf :: buildCellChain (hist ++ [tML]) .leaf :: after := by
              rw [List.append_assoc]; rfl
            rw [h_assoc] at h4a
            have htot := nonHaltingTrace_trans h4a h4bc
            let tAct := encodeCellVal (.active destBit nextQ)
            let tOff := encodeCellVal (.off written)
            refine ⟨_, _, ?_, htot, ?_⟩
            · exact Nat.le_trans (Nat.le_add_left 1 (tML.val + 2)) (Nat.le_add_right _ _)
            · refine ⟨prior, buildCellChain (destHist ++ [tAct]) .leaf,
                buildCellChain ((hist ++ [tML]) ++ [tOff]) .leaf :: after, rfl, hprior_off, ?_, ?_⟩
              · exact ⟨destHist ++ [tAct], rfl, by rw [cellCode_snoc]; exact decode_encode_cellVal _⟩
              · exact ⟨⟨(hist ++ [tML]) ++ [tOff], rfl,
                  by rw [cellCode_snoc]; exact decode_encode_cellVal _⟩, ha⟩

theorem plainRun_simulated (program : BinaryProgram) {n : Nat} {a b : PlainConfig}
    (hrun : PlainRun program n a b) :
    ∀ {root : BTree}, RepPlainBTree root a →
      ∃ k root', NonHaltingResetTrace program k root root' ∧ RepPlainBTree root' b := by
  induction hrun with
  | zero _ => intro root hrep; exact ⟨0, root, .zero root, hrep⟩
  | @next _ a0 b0 _ hstep _ ih =>
    intro root hrep
    obtain ⟨j1, root1, _, htr1, hrep1⟩ := plainStep_simulated program hrep hstep
    obtain ⟨j2, root2, htr2, hrep2⟩ := ih hrep1
    exact ⟨j1 + j2, root2, nonHaltingTrace_trans htr1 htr2, hrep2⟩

private theorem nonHaltingTrace_prefix_det {program : BinaryProgram} {j m : Nat}
    {a b reached : BTree}
    (hnh : NonHaltingResetTrace program j a b)
    (htr : TrivialRootResetTrace program m a reached)
    (hhalt : btreeHaltAccepts reached = true) :
    ∃ r, m = j + r ∧ TrivialRootResetTrace program r b reached := by
  induction hnh generalizing m with
  | zero _ =>
    exact ⟨m, (Nat.zero_add m).symm, htr⟩
  | @succ j0 a0 a1 _ hna hs1 _ ih =>
    cases htr with
    | zero _ =>
      rw [hna] at hhalt
      cases hhalt
    | @succ m0 _ a1' _ hs2 htr0 =>
      have heq := trivialRootResetStep_det hs1 hs2
      subst heq
      obtain ⟨r, hm0, hrest⟩ := ih htr0
      refine ⟨r, ?_, hrest⟩
      rw [hm0, Nat.succ_add]

private theorem trace_halt_implies_plain_stops (program : BinaryProgram) :
    ∀ (fuel m : Nat), m ≤ fuel →
      ∀ {c : PlainConfig} {root reached : BTree},
        RepPlainBTree root c →
        TrivialRootResetTrace program m root reached →
        btreeHaltAccepts reached = true →
        PlainEventuallyStops program c := by
  intro fuel
  induction fuel with
  | zero =>
    intro m hm c root reached hrep htr hhalt
    cases Nat.eq_zero_of_le_zero hm
    cases htr with
    | zero _ =>
      obtain ⟨_, _, _, hroot, _, _, _⟩ := hrep
      subst hroot
      cases hhalt
  | succ fuel ih =>
    intro m hm c root reached hrep htr hhalt
    cases hnext : plainNext program c with
    | none => exact ⟨0, c, PlainRun.zero c, hnext⟩
    | some c' =>
      obtain ⟨j, root', hj_pos, hnh, hrep'⟩ := plainStep_simulated program hrep hnext
      obtain ⟨r, hm_eq, htr_r⟩ := nonHaltingTrace_prefix_det hnh htr hhalt
      have hr_le : r ≤ fuel := by
        have h1 : 1 + r ≤ j + r := Nat.add_le_add_right hj_pos r
        rw [← hm_eq] at h1
        have h2 : r + 1 ≤ fuel + 1 := by
          rw [Nat.add_comm r 1]
          exact Nat.le_trans h1 hm
        exact Nat.le_of_succ_le_succ h2
      obtain ⟨n, final, hrun, hstop⟩ := ih r hr_le hrep' htr_r hhalt
      exact ⟨n + 1, final, PlainRun.next hnext hrun, hstop⟩

/-- **Root-Restarted Finite Tree-Walking Controller Universality over `leaf → node leaf leaf`**:
    For ANY 132-state binary Turing program `program` and initial configuration `initial`,
    `initial` halts iff the root-restarted finite-state tree-walking controller over the
    copying-free trivial leaf-splitting rule `LeafStep` reaches the fixed 3-state regular
    halting language `btreeHaltAccepts`. (100% constructive, zero `Classical.choice`!) -/
theorem trivial_rule_root_reset_universal (program : BinaryProgram) (initial : PlainConfig) :
    PlainEventuallyStops program initial ↔
      ∃ k reached,
        TrivialRootResetTrace program k (encodeInitialBTree initial) reached ∧
        btreeHaltAccepts reached = true := by
  constructor
  · intro ⟨n, final, hrun, hstop⟩
    obtain ⟨k0, rootFinal, hnh, hrepFinal⟩ :=
      plainRun_simulated program hrun (encodeInitialBTree_represents initial)
    obtain ⟨reached, _, hlast, hacc⟩ := plainStop_simulated program hrepFinal hstop
    exact ⟨k0 + 1, reached,
      trivialTrace_trans (nonHaltingTrace_to_trace hnh) (.succ hlast (.zero reached)),
      hacc⟩
  · intro ⟨k, reached, htr, hacc⟩
    exact trace_halt_implies_plain_stops program k k (Nat.le_refl k)
      (encodeInitialBTree_represents initial) htr hacc

/-- **Specialization to the Fixed 132-State Universal Binary Program (`fixedBinaryProgram`)**:
    Even over the algebraically trivial leaf-splitting rule `leaf → node leaf leaf` (zero copying,
    zero `S`), coupling to a program-carrying root-restarted finite tree-walking controller + fixed
    3-state bottom-up regular tree automaton achieves full Turing-universal halting simulation! -/
theorem fixed_universal_trivial_rule_separation (initial : PlainConfig) :
    PlainEventuallyStops fixedBinaryProgram initial ↔
      ∃ k reached,
        TrivialRootResetTrace fixedBinaryProgram k (encodeInitialBTree initial) reached ∧
        btreeHaltAccepts reached = true :=
  trivial_rule_root_reset_universal fixedBinaryProgram initial

end FormalAlgebra.TrivialRuleSeparation

