private theorem evalCtxSN_preserves_nonRescue (c : Ctx) {a b : StateSN}
    (hab : isNonRescuePair a b = true) :
    isNonRescuePair (evalCtxSN c a) (evalCtxSN c b) = true := by
  induction c with
  | hole => exact hab
  | left c' r ih => exact (nonRescue_step ih (evalSN r)).1
  | right l c' ih => exact (nonRescue_step ih (evalSN l)).2

theorem rescue_state_classification (c : Ctx) (st : StateSN)
    (hs0 : evalCtxSN c .sn0 = .sn38) (hst : evalCtxSN c st ≠ .sn38) :
    st = .sn1 ∨ st = .sn8 := by
  have hb := checkAll1_StateSN_sound _ nonRescue_base_chk st
  cases hd : decide (st = .sn1 ∨ st = .sn8) with
  | true => exact of_decide_eq_true hd
  | false =>
    rw [hd, Bool.false_or] at hb
    have hctx := evalCtxSN_preserves_nonRescue c hb
    rw [hs0] at hctx
    have h38 := checkAll1_StateSN_sound _ nonRescue_sn38_chk (evalCtxSN c st)
    simp only [hctx, Bool.not_true, Bool.false_or] at h38
    exfalso
    exact hst (of_decide_eq_true h38)

