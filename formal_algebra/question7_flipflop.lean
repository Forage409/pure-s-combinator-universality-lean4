    (!decide (deltaSN x y = .sn8) || decide (x = .sn0 ∧ y = .sn7))) = true := rfl

theorem closed_evalSN_sn0_eq {p : Term} (hv : noVars p = true) (h : evalSN p = .sn0) : p = S := by
  cases p with
  | s => rfl
  | var _ => cases hv
  | app a b =>
    exfalso
    exact (of_decide_eq_true (checkAll2_StateSN_sound _ deltaSN_ne_sn0_chk (evalSN a) (evalSN b))) h

theorem closed_evalSN_sn1_eq {p : Term} (hv : noVars p = true) (h : evalSN p = .sn1) : p = S ⋅ S := by
  cases p with
  | s => cases h
  | var _ => cases hv
  | app a b =>
    have ⟨hva, hvb⟩ := (Bool.and_eq_true _ _).mp hv
    have hc := checkAll2_StateSN_sound _ deltaSN_eq_sn1_chk (evalSN a) (evalSN b)
    change (!decide (evalSN (a ⋅ b) = .sn1) || decide (evalSN a = .sn0 ∧ evalSN b = .sn0)) = true at hc
    have hc := imp_decide h hc
    have ⟨ha, hb⟩ := of_decide_eq_true hc
    rw [closed_evalSN_sn0_eq hva ha, closed_evalSN_sn0_eq hvb hb]

theorem closed_evalSN_sn7_eq {p : Term} (hv : noVars p = true) (h : evalSN p = .sn7) : p = S ⋅ S ⋅ S := by
  cases p with
  | s => cases h
  | var _ => cases hv
  | app a b =>
    have ⟨hva, hvb⟩ := (Bool.and_eq_true _ _).mp hv
    have hc := checkAll2_StateSN_sound _ deltaSN_eq_sn7_chk (evalSN a) (evalSN b)
    change (!decide (evalSN (a ⋅ b) = .sn7) || decide (evalSN a = .sn1 ∧ evalSN b = .sn0)) = true at hc
    have hc := imp_decide h hc
    have ⟨ha, hb⟩ := of_decide_eq_true hc
    rw [closed_evalSN_sn1_eq hva ha, closed_evalSN_sn0_eq hvb hb]

theorem closed_evalSN_sn8_eq {p : Term} (hv : noVars p = true) (h : evalSN p = .sn8) :
    p = S ⋅ (S ⋅ S ⋅ S) := by
  cases p with
  | s => cases h
  | var _ => cases hv
  | app a b =>
    have ⟨hva, hvb⟩ := (Bool.and_eq_true _ _).mp hv
    have hc := checkAll2_StateSN_sound _ deltaSN_eq_sn8_chk (evalSN a) (evalSN b)
    change (!decide (evalSN (a ⋅ b) = .sn8) || decide (evalSN a = .sn0 ∧ evalSN b = .sn7)) = true at hc
    have hc := imp_decide h hc
    have ⟨ha, hb⟩ := of_decide_eq_true hc
    rw [closed_evalSN_sn0_eq hva ha, closed_evalSN_sn7_eq hvb hb]

/-- **Exact 1-Step Rescue Classification Theorem**:
    For ANY closed 1-hole context `c` and ANY closed pure-`S` term `p`, if `C[S]` is NOT
    strongly normalizing while `C[p]` IS strongly normalizing, then `p` is syntactically
    equal to either `S ⋅ S` (`2` leaves, `.sn1`) or `S ⋅ (S ⋅ S ⋅ S)` (`4` leaves, `.sn8`)! -/
theorem one_step_rescue_classification {c : Ctx} {p : Term}
    (hc : noVarsCtx c = true) (hp : noVars p = true)
    (hnot_s : ¬ StrongNormalizing (plugCtx c S))
    (hsn_p : StrongNormalizing (plugCtx c p)) :
    p = S ⋅ S ∨ p = S ⋅ (S ⋅ S ⋅ S) := by
  have hnv_s : noVars (plugCtx c S) = true := noVars_plugCtx hc rfl
  have hnv_p : noVars (plugCtx c p) = true := noVars_plugCtx hc hp
  have hs38 : evalCtxSN c .sn0 = .sn38 := by
    exact if h : evalSN (plugCtx c S) = .sn38 then
      (evalSN_plugCtx c S).symm.trans h
    else
      False.elim (hnot_s ((waldmann_theorem_9 hnv_s).1.mpr h))
  have hp_ne : evalCtxSN c (evalSN p) ≠ .sn38 := by
    rw [← evalSN_plugCtx c p]
    exact (waldmann_theorem_9 hnv_p).1.mp hsn_p
  rcases rescue_state_classification c (evalSN p) hs38 hp_ne with h1 | h8
  · exact Or.inl (closed_evalSN_sn1_eq hp h1)
  · exact Or.inr (closed_evalSN_sn8_eq hp h8)

def rescueCtxSS : Ctx :=
  Ctx.left (Ctx.left (Ctx.left Ctx.hole A_comb) S) A_comb

def rescueCtxSSSS : Ctx :=
  Ctx.left (Ctx.left (Ctx.left (Ctx.left (Ctx.left Ctx.hole (S ⋅ S)) S) S) S) S

/-- **Realizability Converse for `{S ⋅ S, S ⋅ (S ⋅ S ⋅ S)}`**:
    Both `S ⋅ S` and `S ⋅ (S ⋅ S ⋅ S)` genuinely rescue non-SN closed contexts in 1 leaf replacement. -/
theorem both_rescue_plugs_realized :
    (noVarsCtx rescueCtxSS = true ∧
      ¬ StrongNormalizing (plugCtx rescueCtxSS S) ∧
      StrongNormalizing (plugCtx rescueCtxSS (S ⋅ S))) ∧
    (noVarsCtx rescueCtxSSSS = true ∧
      ¬ StrongNormalizing (plugCtx rescueCtxSSSS S) ∧
      StrongNormalizing (plugCtx rescueCtxSSSS (S ⋅ (S ⋅ S ⋅ S)))) := by
  refine ⟨⟨rfl, r_gadget_s_not_sn, r_gadget_ss_sn⟩, ⟨rfl, ?_, ?_⟩⟩
  · intro hsn
    have hnv : noVars (plugCtx rescueCtxSSSS S) = true := rfl
    exact ((waldmann_theorem_9 hnv).1.mp hsn) rfl
  · have hnv : noVars (plugCtx rescueCtxSSSS (S ⋅ (S ⋅ S ⋅ S))) = true := rfl
    exact (waldmann_theorem_9 hnv).1.mpr (by decide)

end FormalAlgebra

