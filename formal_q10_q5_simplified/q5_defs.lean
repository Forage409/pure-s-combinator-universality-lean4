def out2dListIdx (fi wi : Nat) : List Nat := (out2dTree.lookupNat fi).lookupNat wi
def out2dList (f w : PH) : List Nat := out2dListIdx (phIdx f) (phIdx w)
def out2dHas (f w c d : PH) : Bool := isAccPH c && isAccPH d && memNat (95 * phIdx c + phIdx d) (out2dList f w)
def out2dAllPairs (f w : PH) (P : PH → PH → Bool) : Bool := allNat (fun idx => P (idxToU1 idx) (idxToU2 idx)) (out2dList f w)

def out2d_2d_idx_ok : Bool :=
  checkNat2 95 95 (fun x y =>
    let s1 := dphIdx 0 x; let s2 := dphIdx s1 y
    isAccIdx s2 && Nat.beq (kindIdx s2) 2 && memNat (95 * x + y) (out2dListIdx s1 y) &&
    (let f0 := dphIdx (dphIdx 0 0) x; let n1 := dphIdx 0 y; let n2 := dphIdx x y
     if isAccIdx f0 && isAccIdx (dphIdx f0 y) && !(isZachosIdx f0 && isZachosIdx y) && !(isZachosIdx n1 && isZachosIdx n2)
     then isAccIdx n2 && memNat (95 * y + n2) (out2dListIdx f0 y) else true))

def out2d_trans_idx_row (a : Nat) : Bool :=
  checkNat1 95 (fun b =>
    let f := dphIdx (dphIdx 0 a) b
    if !isAccIdx f then true
    else checkNat1 95 (fun w =>
      let n1 := dphIdx a w; let n2 := dphIdx b w
      if !isAccIdx (dphIdx f w) || (isZachosIdx f && isZachosIdx w) || (isZachosIdx n1 && isZachosIdx n2) then true
      else allNat (fun idx =>
        let u1 := idx / 95; let u2 := idx % 95; let u12 := dphIdx (dphIdx 0 u1) u2
        if isZachosIdx u12 && isZachosIdx n2 then true else subsetNat (out2dListIdx u12 n2) (out2dListIdx f w)) (out2dListIdx a w)))

