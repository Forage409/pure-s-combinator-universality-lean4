theorem allNat_mem {P : Nat → Bool} {x : Nat} : ∀ {xs : List Nat}, allNat P xs = true → memNat x xs = true → P x = true
  | [], _, hm => by cases hm
  | h :: t, hall, hm => by
    have ⟨hP, hrest⟩ := (Bool.and_eq_true _ _).mp hall
    rcases (Bool.or_eq_true _ _).mp hm with heq | htail
    · rw [Nat.eq_of_beq_eq_true heq]; exact hP
    · exact allNat_mem hrest htail
