def beqP (a b : StateP) : Bool := Nat.beq (pIdx a) (pIdx b)
theorem eq_of_beqP {a b : StateP} (h : beqP a b = true) : a = b := by
  have h2 := congrArg ofPIdx (Nat.eq_of_beq_eq_true h); rwa [ofPIdx_pIdx, ofPIdx_pIdx] at h2
theorem ne_of_beqP_false {a b : StateP} (h : beqP a b = false) : a ≠ b := by
  intro heq; subst heq; unfold beqP at h; rw [Nat.beq_refl] at h; cases h

