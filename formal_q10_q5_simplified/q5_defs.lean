def boolBeq : Bool → Bool → Bool | true, true => true | false, false => true | _, _ => false
theorem eq_of_boolBeq : ∀ {a b : Bool}, boolBeq a b = true → a = b
  | true, true, _ => rfl | false, false, _ => rfl | true, false, h => by cases h | false, true, h => by cases h

def existsNat (n : Nat) (f : Nat → Bool) : Bool :=
  match n with | 0 => false | k + 1 => f k || existsNat k f
theorem existsNat_sound (f : Nat → Bool) : ∀ {n : Nat}, existsNat n f = true → ∃ k, k < n ∧ f k = true
  | 0, h => by cases h
  | k + 1, h => by
    rcases (Bool.or_eq_true _ _).mp h with hfk | hrest
    · exact ⟨k, Nat.lt_succ_self k, hfk⟩
    · obtain ⟨m, hm, hfm⟩ := existsNat_sound f hrest; exact ⟨m, Nat.lt_trans hm (Nat.lt_succ_self k), hfm⟩

