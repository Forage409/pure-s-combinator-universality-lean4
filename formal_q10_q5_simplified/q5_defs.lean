def rankP_idx_row (x : Nat) : Bool :=
  checkNat2 39 39 (fun y z =>
    let f := dpIdx (dpIdx 0 x) y
    if Nat.beq x 37 || Nat.beq y 37 || Nat.beq z 37 || Nat.beq f 37 || Nat.beq (dpIdx f z) 37 || (isZachosPIdx f && isZachosPIdx z) then true
    else
      let r := trPIdx x y z; let n1 := dpIdx x z; let n2 := dpIdx y z
      Nat.ble 1 r && Nat.ble r (msPIdx f z) && Nat.ble (msPIdx x z) r && Nat.ble (msPIdx y z) r &&
      (if isZachosPIdx n1 && isZachosPIdx n2 then true
       else (!isS2PTree.lookup x || Nat.ble (msPIdx n1 n2 + 1) r) &&
            checkNat1 39 (fun u => if Nat.beq u 37 || !Nat.beq (dpIdx 0 u) x then true else Nat.ble (trPIdx u z n2 + 1) r)))

