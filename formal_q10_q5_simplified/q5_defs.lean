def PTree.lookupNat {α : Type} (t : PTree α) (n : Nat) : α :=
  let b6 := Nat.ble 64 n; let n := if b6 then n - 64 else n
  let b5 := Nat.ble 32 n; let n := if b5 then n - 32 else n
  let b4 := Nat.ble 16 n; let n := if b4 then n - 16 else n
  let b3 := Nat.ble 8 n;  let n := if b3 then n - 8 else n
  let b2 := Nat.ble 4 n;  let n := if b2 then n - 4 else n
  let b1 := Nat.ble 2 n;  let n := if b1 then n - 2 else n
  t.get b6 b5 b4 b3 b2 b1 (Nat.ble 1 n)

abbrev PH := StateP × StateHN
def ph0 : PH := (.p0, .hn0)
def deltaPH (a b : PH) : PH := (deltaP a.1 b.1, deltaHN a.2 b.2)
def evalPH (t : Term) : PH := (evalP t, evalHN t)
def beqPH (a b : PH) : Bool := beqP a.1 b.1 && beq_StateHN a.2 b.2
theorem eq_of_beqPH {a b : PH} (h : beqPH a b = true) : a = b :=
  let ⟨h1, h2⟩ := (Bool.and_eq_true _ _).mp h; Prod.ext (eq_of_beqP h1) (eq_of_beq_StateHN h2)

